#!/bin/sh
# Recording wrapper; the implementation lives in padilha-capture so the
# command and the panel share one argument and filename contract.
set -u
raw=$0
resolved=$(readlink -f -- "$raw" 2>/dev/null || printf '%s' "$raw")
dir=${resolved%/*}
[ "$dir" = "$resolved" ] && dir=.
exec "$dir/padilha-capture" record "$@"
