#!/bin/sh
# Screen recording around gpu-screen-recorder: start, stop, pause, region.
#
#   padilha-record          start, or stop if already recording
#   padilha-record -s       include the default output's sound
#   padilha-record -r       record a region chosen with slurp
#   padilha-record -p       pause/resume
#   padilha-record --dry-run
set -u

recorder=gpu-screen-recorder
state=${XDG_STATE_HOME:-$HOME/.local/state}/caelestia
target=$state/record/recording.mp4
videos=${XDG_VIDEOS_DIR:-$HOME/Videos}/Recordings
idfile=$state/record/notifid.txt

dry=0
sound=0
region=0
pause=0

usage() {
    printf 'usage: %s [-s] [-r] [-p] [--dry-run]\n' "${0##*/}"
}

while [ $# -gt 0 ]; do
    case $1 in
        -s|--sound) sound=1 ;;
        -r|--region) region=1 ;;
        -p|--pause) pause=1 ;;
        --dry-run) dry=1 ;;
        -h|--help) usage; exit 0 ;;
        *) printf '%s: unknown option: %s\n' "${0##*/}" "$1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

running() { pidof "$recorder" >/dev/null 2>&1; }

run() {
    if [ "$dry" = 1 ]; then
        printf '%s\n' "$*"
        return 0
    fi
    "$@"
}

notify() { notify-send -a padilha-record "$@"; }

monitor_json() { hyprctl monitors -j 2>/dev/null; }

focused() {
    monitor_json | tr '}' '\n' | grep '"focused": true' |
        sed -n 's/.*"name": "\([^"]*\)".*/\1/p' | head -n 1
}

refresh() {
    monitor_json | tr '}' '\n' | grep '"focused": true' |
        sed -n 's/.*"refreshRate": \([0-9.]*\).*/\1/p' | head -n 1 | cut -d. -f1
}

if [ "$pause" = 1 ]; then
    run pkill -USR2 -f "$recorder"
    exit 0
fi

if running; then
    run pkill -f "$recorder"
    if [ "$dry" = 0 ]; then
        # gpu-screen-recorder finalises the file on exit; wait for it.
        n=0
        while running && [ "$n" -lt 50 ]; do
            sleep 0.1
            n=$((n + 1))
        done
        mkdir -p "$videos" 2>/dev/null || true
        name=$(date +%Y-%m-%d_%H.%M.%S).mp4
        if [ -f "$target" ]; then
            mv -f "$target" "$videos/$name" 2>/dev/null || true
            notify -i camera-video-symbolic "Recording saved" "$videos/$name"
        else
            notify -i dialog-error-symbolic "Recording failed" "No file was written"
        fi
    fi
    exit 0
fi

mkdir -p "$state/record" 2>/dev/null || true

args="-w"
if [ "$region" = 1 ]; then
    if [ "$dry" = 1 ]; then
        run slurp -f '%wx%h+%x+%y'
        args="$args -region 640x480+0+0 -f 60"
    else
        geo=$(slurp -f '%wx%h+%x+%y' 2>/dev/null) || exit 0
        [ -n "$geo" ] || exit 0
        args="$args -region $geo -f 60"
    fi
else
    mon=$(focused)
    rr=$(refresh)
    [ -n "$rr" ] || rr=60
    args="$args $mon -f $rr"
fi

[ "$sound" = 1 ] && args="$args -a default_output"
record_args=${PADILHA_RECORD_ARGS:-${LILITH_RECORD_ARGS:-}}
[ -n "$record_args" ] && args="$args $record_args"

if [ "$dry" = 1 ]; then
    printf '%s %s -o %s\n' "$recorder" "$args" "$target"
    exit 0
fi

# shellcheck disable=SC2086
setsid "$recorder" $args -o "$target" >/dev/null 2>&1 &
sleep 1
if ! running; then
    notify -i dialog-error-symbolic "Recording failed" "gpu-screen-recorder did not start"
    exit 1
fi

notify -p -i camera-video-symbolic "Recording" "Recording the screen; run padilha-record again to stop" > "$idfile" 2>/dev/null || true
