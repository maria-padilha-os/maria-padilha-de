#!/bin/sh
# Screenshots. Full monitor goes straight to the clipboard; -r hands over to
# the shell's own area picker, which knows about freeze frames and the rest.
#
#   padilha-shot              focused monitor
#   padilha-shot -r           region, through `qs ipc call picker open`
#   padilha-shot --dry-run    print the commands instead of running them
set -u

dry=0
region=0

usage() {
    printf 'usage: %s [-r|--region] [--dry-run]\n' "${0##*/}"
}

while [ $# -gt 0 ]; do
    case $1 in
        -r|--region) region=1 ;;
        --dry-run) dry=1 ;;
        -h|--help) usage; exit 0 ;;
        *) printf '%s: unknown option: %s\n' "${0##*/}" "$1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

shots=${XDG_CACHE_HOME:-$HOME/.cache}/caelestia/screenshots

notify() {
    notify-send -a padilha-shot -i image-x-generic-symbolic "$@"
}

run() {
    if [ "$dry" = 1 ]; then
        printf '%s\n' "$*"
        return 0
    fi
    "$@"
}

monitor() {
    command -v hyprctl >/dev/null 2>&1 || return 0
    hyprctl monitors -j 2>/dev/null |
        sed -n 's/.*"name": "\([^"]*\)".*/\1/p' | head -n 1
}

if [ "$region" = 1 ]; then
    # The picker copies the selection itself; no grim here.
    run qs -c caelestia ipc call picker open
    exit 0
fi

mon=$(monitor)
mkdir -p "$shots" 2>/dev/null || true
stamp=$(date +%Y%m%d%H%M%S)
dest=$shots/$stamp.png

if [ "$dry" = 1 ]; then
    printf 'grim%s - | wl-copy\n' "${mon:+ -o $mon}"
    printf 'save %s\n' "$dest"
    exit 0
fi

if [ -n "$mon" ]; then
    grim -o "$mon" - > "$dest"
else
    grim - > "$dest"
fi || { notify "Screenshot failed" "grim could not capture the screen"; exit 1; }
if wl-copy < "$dest"; then
    notify -h "STRING:image-path:$dest" "Screenshot taken" "Copied to the clipboard"
else
    notify -h "STRING:image-path:$dest" "Screenshot saved" "$dest (clipboard unavailable)"
fi
