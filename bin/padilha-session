#!/bin/sh
# Start (or no-op) the shell, compiling the Lua config first.
#
# The compile is atomic: on a bad config padilha-config keeps the previous
# shell.json and the session still starts. Run from hyprland/execs.lua.
set -u

# Follow the symlink: a packaged install keeps the real file in
# /usr/lib/padilha/bin and only links it into /usr/bin.
self=$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")
bin_dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd) || exit 1

config="$bin_dir/padilha-config"
# The shell's settings UI spawns `padilha-config capture`; name the exact
# binary this session compiled with, so a checkout and a package both work.
export PADILHA_CONFIG="$config"

# First login on a fresh machine: there is no init.lua yet.
if [ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/padilha/init.lua" ]; then
    "$config" init >/dev/null 2>&1 || true
fi

if ! "$config" compile --quiet; then
    command -v notify-send >/dev/null 2>&1 &&
        notify-send -a padilha-config "Config not applied" "init.lua failed to compile; keeping the previous shell.json"
fi

# Colours before the first paint: apply the current period's wallpaper and
# palette. The daylight daemon repeats this later only when the period moves.
"$bin_dir/padilha-daylight" --once >/dev/null 2>&1 || true

# A checkout carries its own C++ QML modules in build/qml. Prefer them over an
# older installed copy: the settings schema ships there (a stale module would
# hide new bar entries). A packaged install has no build tree and uses the
# system module.
build_qml="$bin_dir/../build/qml"
if [ -d "$build_qml" ]; then
    QML2_IMPORT_PATH="$build_qml${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
    export QML2_IMPORT_PATH
fi

exec qs -c caelestia -n -d
