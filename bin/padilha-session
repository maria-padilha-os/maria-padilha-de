#!/bin/sh
# Start (or no-op) the shell, compiling the Lua config first.
#
# The compile is atomic: on a bad config padilha-config keeps the previous
# shell.json and the session still starts. Run from hyprland/execs.lua.
set -u

# Follow the symlink: a packaged install keeps the real file in
# /usr/lib/maria-padilha/bin and only links it into /usr/bin.
self=$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")
bin_dir=$(CDPATH='' cd -- "$(dirname -- "$self")" && pwd) || exit 1

config="$bin_dir/padilha-config"
# The shell's settings UI spawns `padilha-config capture`; name the exact
# binary this session compiled with, so a checkout and a package both work.
export PADILHA_CONFIG="$config"
# The installed settings module still reads the old name during the transition.
export LILITH_CONFIG="$config"
# The clipboard widget launches this exact helper, so it also works from a
# checkout without installing the command first.
export PADILHA_CLIPBOARD="$bin_dir/padilha-clipboard"

# First login on a fresh machine: there is no init.lua yet. The old
# ~/.config/lilith tree still counts as configured during the migration.
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
if [ ! -f "$config_home/padilha/init.lua" ] && [ ! -f "$config_home/lilith/init.lua" ]; then
    "$config" init >/dev/null 2>&1 || true
fi

# The shell's Qt locale must follow the configured UI language even when the
# watchdog starts it with the login environment used before a language change.
shell_json="$config_home/padilha/shell.json"
if [ -f "$shell_json" ] && command -v jq >/dev/null 2>&1; then
    language=$(jq -r '.general.language // empty' "$shell_json" 2>/dev/null || true)
    case "$language" in
        pt_BR | pt_BR.UTF-8)
            export LANG=pt_BR.UTF-8
            export LC_TIME=pt_BR.UTF-8
            ;;
        pt_PT | pt_PT.UTF-8)
            export LANG=pt_PT.UTF-8
            export LC_TIME=pt_PT.UTF-8
            ;;
        en | en_US | en_US.UTF-8)
            export LANG=en_US.UTF-8
            export LC_TIME=en_US.UTF-8
            ;;
    esac
fi

if ! "$config" compile --quiet; then
    command -v notify-send >/dev/null 2>&1 &&
        notify-send -a padilha-config "Config not applied" "init.lua failed to compile; keeping the previous shell.json"
fi

# Colours before the first paint: apply the current period's wallpaper and
# palette. The daylight daemon repeats this later only when the period moves.
"$bin_dir/padilha-daylight" --once >/dev/null 2>&1 || true

# A checkout carries its own C++ QML modules in build/qml. Prefer them over an
# older installed copy: the settings schema ships there (a stale module would
# hide new bar entries). A packaged install has no build tree and uses the
# system module.
build_qml="$bin_dir/../build/qml"
if [ -d "$build_qml" ]; then
    QML2_IMPORT_PATH="$build_qml${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
    export QML2_IMPORT_PATH
fi

exec qs -c caelestia -n -d
