#!/usr/bin/env lua
-- padilha-colour: parse a picked colour and put it on the clipboard.
--
--   padilha-colour pick [--json] [--no-copy]   sample with hyprpicker
--   padilha-colour parse VALUE [--json]        print HEX, RGB and HSL
--   padilha-colour copy VALUE                  copy VALUE's hexadecimal form
--
-- Only an explicit `pick` starts the Wayland picker. It runs in the
-- foreground, exits as soon as a colour is selected (or Escape is pressed),
-- and never captures or writes a screenshot. The shell's bar widget uses
-- `pick --json`; the other commands exist for keybinds and for the tests.
--
-- Exit status: 0 success, 1 invalid colour/output, 2 usage, 3 cancelled,
-- 4 clipboard failure, 5 picker unavailable.

local function script_dir()
    -- Follow the symlink: packaged installs put the real files under
    -- /usr/lib/maria-padilha/bin and only links in /usr/bin.
    local raw = arg[0] or "padilha-colour"
    local p = io.popen("readlink -f -- '" .. raw:gsub("'", "'\\''") .. "' 2>/dev/null")
    local resolved = p and p:read("*l")
    if p then
        p:close()
    end
    local path = (resolved and resolved ~= "") and resolved or raw
    return path:match("^(.*)/[^/]+$") or "."
end

local root = script_dir() .. "/.."
package.path = root .. "/lib/?.lua;" .. package.path

local json = require("json")

local function die(message, code)
    io.stderr:write("padilha-colour: ", message, "\n")
    os.exit(code or 1)
end

local function quote(s)
    return "'" .. tostring(s):gsub("'", "'\\''") .. "'"
end

local function usage(code)
    io.stderr:write([[
usage: padilha-colour <command> [options]

  pick [--json] [--no-copy]   sample a colour with hyprpicker and copy it
  parse VALUE [--json]        print the HEX, RGB and HSL forms of a colour
  copy VALUE                  copy a colour's hexadecimal form

  --json       machine-readable output for the shell
  --no-copy    pick without writing the clipboard

  Ways to give a colour: #RRGGBB, #RGB, rgb(R, G, B) or hsl(H, S%, L%).
  Exit status: 0 success, 1 invalid, 2 usage, 3 cancelled, 4 clipboard,
  5 picker unavailable.
]])
    os.exit(code or 2)
end

local function help()
    usage(0)
end

local function take_flag(args, name)
    for i, a in ipairs(args) do
        if a == name then
            table.remove(args, i)
            return true
        end
    end
    return false
end

local function round(n)
    return math.floor(n + 0.5)
end

local function clamp_byte(n)
    return math.max(0, math.min(255, round(n)))
end

local function rgb_to_hsl(r, g, b)
    r, g, b = r / 255, g / 255, b / 255
    local maxv = math.max(r, g, b)
    local minv = math.min(r, g, b)
    local l = (maxv + minv) / 2
    local d = maxv - minv
    local h, s = 0, 0

    if d ~= 0 then
        s = l > 0.5 and d / (2 - maxv - minv) or d / (maxv + minv)
        if maxv == r then
            h = ((g - b) / d) % 6
        elseif maxv == g then
            h = (b - r) / d + 2
        else
            h = (r - g) / d + 4
        end
        h = h * 60
    end

    return h, s, l
end

local function hue_channel(p, q, t)
    if t < 0 then
        t = t + 1
    elseif t > 1 then
        t = t - 1
    end
    if t < 1 / 6 then
        return p + (q - p) * 6 * t
    elseif t < 1 / 2 then
        return q
    elseif t < 2 / 3 then
        return p + (q - p) * (2 / 3 - t) * 6
    end
    return p
end

local function hsl_to_rgb(h, s, l)
    if s <= 0 then
        local v = clamp_byte(l * 255)
        return v, v, v
    end
    local q = l < 0.5 and l * (1 + s) or l + s - l * s
    local p = 2 * l - q
    h = (h % 360) / 360
    return clamp_byte(hue_channel(p, q, h + 1 / 3) * 255),
        clamp_byte(hue_channel(p, q, h) * 255),
        clamp_byte(hue_channel(p, q, h - 1 / 3) * 255)
end

local function parse_channel(part)
    part = part:match("^%s*(.-)%s*$")
    if part:match("^%d+$") then
        local n = tonumber(part)
        if n and n >= 0 and n <= 255 then
            return n
        end
    end
    local percent = part:match("^([%d%.]+)%%$")
    if percent then
        local n = tonumber(percent)
        if n and n >= 0 and n <= 100 then
            return clamp_byte(n * 255 / 100)
        end
    end
    return nil
end

local function parse_percent(part)
    part = part:match("^%s*(.-)%s*$")
    local n = tonumber(part:match("^([%d%.]+)%%$") or part)
    if not n or n < 0 or n > 100 then
        return nil
    end
    return n / 100
end

local function parse_colour(value)
    if type(value) ~= "string" then
        return nil
    end
    local raw = value:match("^%s*(.-)%s*$")
    if raw == "" then
        return nil
    end
    local lower = raw:lower()

    local hex = lower:match("^#?(%x%x%x%x%x%x)$")
    if hex then
        return tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16)
    end

    local short = lower:match("^#(%x%x%x)$")
    if short then
        local r = tonumber(short:sub(1, 1) .. short:sub(1, 1), 16)
        local g = tonumber(short:sub(2, 2) .. short:sub(2, 2), 16)
        local b = tonumber(short:sub(3, 3) .. short:sub(3, 3), 16)
        return r, g, b
    end

    local body = lower:match("^rgb%s*%(([^)]*)%)$") or lower:match("^rgba%s*%(([^)]*)%)$")
    if body then
        local parts = {}
        for part in body:gmatch("[^,]+") do
            parts[#parts + 1] = part
        end
        if #parts == 3 or #parts == 4 then
            local r = parse_channel(parts[1])
            local g = parse_channel(parts[2])
            local b = parse_channel(parts[3])
            if r and g and b then
                return r, g, b
            end
        end
        return nil
    end

    body = lower:match("^hsl%s*%(([^)]*)%)$") or lower:match("^hsla%s*%(([^)]*)%)$")
    if body then
        local parts = {}
        for part in body:gmatch("[^,]+") do
            parts[#parts + 1] = part
        end
        if #parts == 3 or #parts == 4 then
            local h = tonumber(parts[1]:match("^%s*([%d%.]+)%s*$"))
            local s = parse_percent(parts[2])
            local l = parse_percent(parts[3])
            if h and s and l then
                return hsl_to_rgb(h, s, l)
            end
        end
    end

    return nil
end

local function describe(r, g, b)
    local h, s, l = rgb_to_hsl(r, g, b)
    local hue = round(h) % 360
    local saturation = round(s * 100)
    local lightness = round(l * 100)
    return {
        hex = string.format("#%02x%02x%02x", r, g, b),
        rgb = string.format("rgb(%d, %d, %d)", r, g, b),
        hsl = string.format("hsl(%d, %d%%, %d%%)", hue, saturation, lightness),
        red = r,
        green = g,
        blue = b,
        hue = hue,
        saturation = saturation,
        lightness = lightness,
    }
end

local function print_colour(info, as_json)
    if as_json then
        io.write(json.encode(info))
        return
    end
    io.write("HEX=", info.hex, "\n")
    io.write("RGB=", info.rgb, "\n")
    io.write("HSL=", info.hsl, "\n")
end

local function command_exists(command)
    return os.execute("command -v " .. quote(command) .. " >/dev/null 2>&1") == true
end

local function copy_to_clipboard(text)
    if not command_exists("wl-copy") then
        return false, "wl-copy is not installed"
    end
    local ok, _, code = os.execute("printf '%s' " .. quote(text) .. " | wl-copy")
    if ok == true then
        return true
    end
    return false, "wl-copy could not set the clipboard (exit " .. tostring(code or 1) .. ")"
end

local function pick_colour()
    local picker = os.getenv("PADILHA_COLOUR_PICKER")
    if not picker or picker == "" then
        picker = "hyprpicker"
    end
    if not command_exists(picker) then
        die(picker .. " is not installed; install hyprpicker for the colour picker", 5)
    end

    local p = io.popen(quote(picker) .. " 2>/dev/null", "r")
    if not p then
        die("could not start " .. picker, 5)
    end
    local output = p:read("*a") or ""
    local ok, _, code = p:close()
    local status = ok == true and 0 or tonumber(code) or 1
    return output, status
end

local function parse_or_die(value)
    local r, g, b = parse_colour(value)
    if not r then
        local shown = tostring(value):gsub("%s+", " ")
        if #shown > 60 then
            shown = shown:sub(1, 57) .. "..."
        end
        die(("not a colour: %q (want #RRGGBB, #RGB, rgb(...) or hsl(...))"):format(shown))
    end
    return describe(r, g, b)
end

local args = { ... }
local command = table.remove(args, 1)
if command == nil or command == "-h" or command == "--help" then
    if command == nil then
        usage()
    end
    help()
end

if command == "pick" then
    local as_json = take_flag(args, "--json")
    local no_copy = take_flag(args, "--no-copy")
    if take_flag(args, "-h") or take_flag(args, "--help") then
        help()
    end
    if #args ~= 0 then
        usage()
    end

    local output, status = pick_colour()
    local value = output:match("^%s*(.-)%s*$")
    if value == "" then
        -- Escape, or a picker that exited without a selection: no-op.
        os.exit(3)
    end

    local info = parse_or_die(value)
    if status ~= 0 then
        -- A killed/misbehaving picker with text is still not a trustworthy
        -- selection; report the output as invalid instead of copying it.
        die(("picker exited with status %d"):format(status))
    end

    print_colour(info, as_json)
    if not no_copy then
        local copied, message = copy_to_clipboard(info.hex)
        if not copied then
            die(message, 4)
        end
    end
elseif command == "parse" then
    local as_json = take_flag(args, "--json")
    if take_flag(args, "-h") or take_flag(args, "--help") then
        help()
    end
    if #args ~= 1 then
        usage()
    end
    print_colour(parse_or_die(args[1]), as_json)
elseif command == "copy" then
    if take_flag(args, "-h") or take_flag(args, "--help") then
        help()
    end
    if #args ~= 1 then
        usage()
    end
    local info = parse_or_die(args[1])
    local copied, message = copy_to_clipboard(info.hex)
    if not copied then
        die(message, 4)
    end
    io.write(info.hex, "\n")
else
    usage()
end
