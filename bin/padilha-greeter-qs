#!/bin/sh
# Start the Quickshell greeter in cage, falling back to tuigreet.
#
# greetd runs this as the unprivileged greeter user:
#   /usr/bin/padilha-greeter-qs
#
# A successful authentication launches the user session and Quickshell exits
# cleanly; a crash or a missing cage/Quickshell falls back to tuigreet instead
# of leaving the machine at a dead login screen.
set -u

self=$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")
bin_dir=$(CDPATH='' cd -- "$(dirname -- "$self")" && pwd) || exit 1
greeter="$bin_dir/padilha-greeter"

# Cage does not read localectl/Xorg. wlroots takes the keymap from these
# variables; without them the greeter falls back to US and a Brazilian
# password containing @, /, ç, etc. authenticates with the wrong characters.
export XKB_DEFAULT_LAYOUT="${XKB_DEFAULT_LAYOUT:-br}"
export XKB_DEFAULT_VARIANT="${XKB_DEFAULT_VARIANT:-}"

if command -v cage >/dev/null 2>&1 && [ -x "$greeter" ]; then
    # -s keeps Ctrl+Alt+F* working if the greeter misbehaves.
    cage -s -- "$greeter"
    status=$?
    if [ "$status" -eq 0 ]; then
        exit 0
    fi
fi

if command -v maria-padilha-greeter >/dev/null 2>&1; then
    exec maria-padilha-greeter \
        --sessions /usr/share/wayland-sessions \
        --greeting "Maria Padilha"
fi

exec tuigreet \
    --sessions /usr/share/wayland-sessions \
    --greeting "Maria Padilha"
