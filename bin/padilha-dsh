#!/usr/bin/python3
"""Small stdio adapter that lets the desktop widget drive DeepSeek Harness.

The widget speaks one JSON object per line. History and the session list come
from DSH's on-disk session logs; prompts are forwarded to `dsh sdk`, whose
JSON-RPC notifications are translated back into the widget's message events.
"""

from __future__ import annotations

import base64
import fcntl
import json
import mimetypes
import os
import shutil
import subprocess
import sys
import threading
import time
import uuid
from pathlib import Path
from typing import Any, Iterator

DSH_HOME = Path(os.environ.get("DSH_HOME", Path.home() / ".dsh")).expanduser()
os.environ.setdefault("DSH_PERMISSION_MODE", "danger-full-access")
PROVIDER = os.environ.get("PADILHA_DSH_PROVIDER", "deepseek-official")
MODEL = os.environ.get("PADILHA_DSH_MODEL", "deepseek-flash")
MAX_HISTORY = 80
MAX_LIST = 200
PROMPT_TIMEOUT = 60 * 15
DEFAULT_SESSION_FILE = Path(os.environ.get("PADILHA_DSH_DEFAULT_FILE", Path.home() / ".config/padilha/dsh-default-session"))
EFFORT_FILE = Path(os.environ.get("PADILHA_DSH_EFFORT_FILE", Path.home() / ".dsh-tui/effort.json"))


def reasoning_effort() -> str:
    """Last /effort choice used by dsh-tui, or empty when unset."""
    try:
        parsed = json.loads(EFFORT_FILE.read_text())
    except (OSError, ValueError):
        return ""
    if not isinstance(parsed, dict):
        return ""
    effort = parsed.get("effort")
    return effort if isinstance(effort, str) else ""


def emit(payload: dict[str, Any]) -> None:
    sys.stdout.write(json.dumps(payload, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def load_credential() -> None:
    """Load the DSH key from its private file if the launcher lacks it.

    The widget runs under the desktop session, which does not inherit the
    terminal's DEEPSEEK_API_KEY. The file is intentionally outside the repo and
    must stay mode 0600; the value is never logged or passed on a command line.
    """
    if os.environ.get("DEEPSEEK_API_KEY"):
        return
    path = Path(os.environ.get("PADILHA_DSH_KEY_FILE", Path.home() / ".config/padilha/dsh-key"))
    try:
        info = path.stat()
    except OSError:
        return
    if info.st_mode & 0o077:
        return
    try:
        key = path.read_text(encoding="utf-8").strip()
    except OSError:
        return
    if key:
        os.environ["DEEPSEEK_API_KEY"] = key


def session_dirs() -> list[Path]:
    root = DSH_HOME / "sessions"
    if not root.is_dir():
        return []
    out: list[Path] = []
    try:
        projects = [p for p in root.iterdir() if p.is_dir()]
    except OSError:
        return []
    for project in projects:
        try:
            out.extend(p for p in project.iterdir() if p.is_dir())
        except OSError:
            continue
    def modified(session: Path) -> float:
        log = log_path(session)
        try:
            return log.stat().st_mtime if log is not None else session.stat().st_mtime
        except OSError:
            return 0

    return sorted(out, key=modified, reverse=True)


def log_path(session: Path) -> Path | None:
    for candidate in (session / "session.v4.jsonl.zstd", session / "session.jsonl.zstd"):
        if candidate.is_file():
            return candidate
    return None


def session_owned(session: Path) -> bool:
    """Whether another DSH process currently holds the session's writer lock."""
    lock = session / "session.lock"
    try:
        fd = os.open(lock, os.O_RDWR)
    except OSError:
        return False
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        fcntl.flock(fd, fcntl.LOCK_UN)
        return False
    finally:
        os.close(fd)


def events(path: Path, limit: int | None = None) -> Iterator[dict[str, Any]]:
    proc = subprocess.Popen(
        ["zstd", "-dc", str(path)],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        encoding="utf-8",
        errors="replace",
    )
    assert proc.stdout is not None
    try:
        for line in proc.stdout:
            if limit is not None and limit <= 0:
                break
            if limit is not None:
                limit -= 1
            try:
                event = json.loads(line)
            except ValueError:
                continue
            if isinstance(event, dict):
                yield event
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=1)
        except subprocess.TimeoutExpired:
            proc.kill()


def text_blocks(content: Any) -> str:
    if not isinstance(content, list):
        return ""
    parts: list[str] = []
    for block in content:
        if isinstance(block, dict) and block.get("type") == "text":
            text = block.get("text")
            if isinstance(text, str) and text.strip():
                parts.append(text)
    return "\n\n".join(parts).strip()


def history(path: Path, max_messages: int = MAX_HISTORY) -> list[dict[str, str]]:
    out: list[dict[str, str]] = []
    for event in events(path):
        kind = event.get("type")
        data = event.get("data")
        if not isinstance(data, dict):
            continue
        if kind == "user/message":
            source = data.get("source")
            if not isinstance(source, dict) or source.get("kind") != "user":
                continue
            text = text_blocks(data.get("content"))
            if text:
                out.append({"role": "user", "text": text})
        elif kind == "assistant/message":
            message = data.get("message")
            if not isinstance(message, dict):
                continue
            text = text_blocks(message.get("content"))
            if text:
                out.append({"role": "assistant", "text": text})
    return out[-max_messages:]


def context_pressure(usage: Any) -> int:
    if not isinstance(usage, dict):
        return 0
    return sum(
        int(usage.get(key) or 0)
        for key in ("inputTokens", "cacheReadTokens", "cacheWriteTokens")
    )


def session_context(path: Path | None) -> dict[str, Any]:
    """Latest provider-reported prompt size and the route's context window."""
    if path is None:
        return {"tokens": 0, "window": 0, "usage": {}}
    window = 0
    usage: Any = None
    for event in events(path):
        kind = event.get("type")
        data = event.get("data")
        if not isinstance(data, dict):
            continue
        if kind == "request/context":
            try:
                window = int(data.get("contextWindow") or 0)
            except (TypeError, ValueError):
                window = 0
        elif kind == "assistant/message" and isinstance(data.get("usage"), dict):
            usage = data.get("usage")
    return {
        "tokens": context_pressure(usage),
        "window": window,
        "usage": usage if isinstance(usage, dict) else {},
    }


def command_like(text: str) -> bool:
    text = text.strip()
    return (
        text.startswith(("DSH_", "(", "cd ", "exec ", "bash ", "zsh ", "fish "))
        or "dsh --profile" in text
    )


def first_user(path: Path) -> tuple[str, str]:
    """Return (title, cwd) using the first real user prompt in a session."""
    title = ""
    fallback = ""
    cwd = ""
    for event in events(path, limit=600):
        if not cwd and event.get("type") == "session":
            candidate = event.get("cwd")
            if isinstance(candidate, str):
                cwd = candidate
        if event.get("type") == "user/message":
            data = event.get("data")
            if not isinstance(data, dict):
                continue
            source = data.get("source")
            if not isinstance(source, dict) or source.get("kind") != "user":
                continue
            text = text_blocks(data.get("content")).strip()
            if not text or text in (".", "..", "/", "?"):
                continue
            if not fallback:
                fallback = " ".join(text.split())[:72]
            if command_like(text):
                continue
            title = " ".join(text.split())[:72]
            break
    return title or fallback, cwd


def session_summary(session: Path) -> dict[str, Any] | None:
    path = log_path(session)
    if path is None:
        return None
    title, cwd = first_user(path)
    try:
        updated = path.stat().st_mtime
    except OSError:
        updated = 0
    if not title:
        title = Path(cwd).name if cwd else f"Session {session.name.removeprefix('session-')[:8]}"
    if command_like(title) or title.startswith("You are "):
        title = Path(cwd).name if cwd else title[:72]
    return {
        "id": session.name,
        "title": title,
        "cwd": cwd,
        "updated": int(updated * 1000),
        "owned": session_owned(session),
    }


def list_sessions(limit: int = MAX_LIST) -> list[dict[str, Any]]:
    out: list[dict[str, Any]] = []
    default_id = default_session_id()
    for session in session_dirs():
        item = session_summary(session)
        if item is not None:
            if item["id"] == default_id:
                item["title"] = "Padilha"
            out.append(item)
        if len(out) >= limit:
            break
    return out


def list_subagents(parent_id: str, limit: int = 12) -> list[dict[str, Any]]:
    """Active DSH subagent sessions spawned by the given parent session."""
    if not parent_id:
        return []
    out: list[dict[str, Any]] = []
    cutoff = time.time() - 86400
    for session in session_dirs():
        path = log_path(session)
        if path is None:
            continue
        try:
            mtime = path.stat().st_mtime
        except OSError:
            continue
        if mtime < cutoff:
            continue
        origin = ""
        parent = ""
        cwd = ""
        label = ""
        try:
            for event in events(path, limit=20):
                kind = event.get("type")
                if kind == "session":
                    origin = str(event.get("origin") or "")
                    parent = str(event.get("parentSession") or "")
                    cwd = str(event.get("cwd") or "")
                elif kind == "subagent/descriptor":
                    data = event.get("data")
                    if isinstance(data, dict):
                        label = str(data.get("label") or "")
        except Exception:
            continue
        if origin != "subagent" or parent != parent_id:
            continue
        if not session_owned(session):
            continue
        out.append(
            {
                "id": session.name,
                "label": label or "Agent",
                "cwd": cwd,
                "updated": int(mtime * 1000),
                "owned": True,
            }
        )
        if len(out) >= limit:
            break
    out.sort(key=lambda item: item["updated"], reverse=True)
    return out


def find_session(session_id: str) -> Path | None:
    for session in session_dirs():
        if session.name == session_id:
            return session
    return None


def default_session_id() -> str:
    try:
        return DEFAULT_SESSION_FILE.read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def resolve_session(session_id: str | None) -> tuple[str, Path | None]:
    if session_id:
        path = find_session(session_id)
        if path is not None:
            return session_id, path
        return session_id, None
    return str(uuid.uuid4()), None


def dsh_binary() -> str | None:
    """Find dsh even when the desktop service has a minimal PATH."""
    override = os.environ.get("DSH_BIN")
    candidates = [
        Path(override).expanduser() if override else None,
        Path(shutil.which("dsh")) if shutil.which("dsh") else None,
        Path.home() / ".npm-global/bin/dsh",
        Path("/usr/local/bin/dsh"),
        Path("/usr/bin/dsh"),
    ]
    for candidate in candidates:
        if candidate is not None and candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    return None


def activity_label(name: str, arguments: Any) -> str:
    """Short, human-readable activity for a DSH tool call."""
    values: dict[str, Any] = {}
    if isinstance(arguments, dict):
        values = arguments
    elif isinstance(arguments, str):
        try:
            parsed = json.loads(arguments)
            if isinstance(parsed, dict):
                values = parsed
        except ValueError:
            pass
    if name in ("bash", "shell"):
        description = str(values.get("description") or "").strip()
        command = str(values.get("command") or "").strip()
        detail = description or command.splitlines()[0] if command else ""
        return "Running shell" + (f" · {detail[:90]}" if detail else "")
    if name in ("read", "read_file"):
        return f"Reading {str(values.get('path') or '')[:90]}".strip()
    if name in ("write", "write_file", "edit", "apply_patch"):
        return f"Editing {str(values.get('path') or '')[:90]}".strip()
    if name in ("list_dir", "ls"):
        return f"Listing {str(values.get('path') or '')[:90]}".strip()
    if name in ("search", "search_text", "grep"):
        return f"Searching for {str(values.get('query') or '')[:70]}".strip()
    if name in ("ask_user", "ask_user_question"):
        return "Waiting for your answer"
    return f"Using {name}"


MAX_ATTACHMENT_BYTES = 12 * 1024 * 1024


def attachment_content_block(path: str) -> dict[str, Any]:
    """Encode a local image or small UTF-8 text file as a prompt block."""
    file = Path(path).expanduser()
    if not file.is_file():
        raise SdkError(f"Attachment not found: {path}")
    if file.stat().st_size > MAX_ATTACHMENT_BYTES:
        raise SdkError(f"Attachment is too large: {file.name}")
    mime = mimetypes.guess_type(file.name)[0] or "application/octet-stream"
    if mime.startswith("image/"):
        return {
            "type": "image",
            "mimeType": mime,
            "data": base64.b64encode(file.read_bytes()).decode("ascii"),
        }
    try:
        body = file.read_text(encoding="utf-8")
    except UnicodeDecodeError as error:
        raise SdkError(f"Attachment is neither an image nor UTF-8 text: {file.name}") from error
    return {"type": "text", "text": f"\n\nAttached file {file.name}:\n{body}"}


class SdkError(RuntimeError):
    pass


class Cancelled(RuntimeError):
    pass


class DshSdk:
    def __init__(self) -> None:
        self.proc: subprocess.Popen[str] | None = None
        self.next_id = 1
        self.initialized = False
        self.cancel = threading.Event()
        self.lock = threading.Lock()
        self.owned: set[str] = set()

    def _ensure(self, cwd: str) -> None:
        if self.proc is not None and self.proc.poll() is None:
            return
        binary = dsh_binary()
        if binary is None:
            raise SdkError("dsh not found; install DeepSeek Harness or set DSH_BIN")
        self.proc = subprocess.Popen(
            [binary, "sdk"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            encoding="utf-8",
            errors="replace",
            bufsize=1,
        )
        self.initialized = False
        self.next_id = 1
        self._request(
            "initialize",
            {
                "cwd": cwd,
                "provider": PROVIDER,
                "model": MODEL,
            },
        )
        self.initialized = True

    def _write(self, payload: dict[str, Any]) -> None:
        if self.proc is None or self.proc.stdin is None:
            raise SdkError("DSH SDK process is not running")
        with self.lock:
            self.proc.stdin.write(json.dumps(payload) + "\n")
            self.proc.stdin.flush()

    def _read(self) -> dict[str, Any]:
        if self.proc is None or self.proc.stdout is None:
            raise SdkError("DSH SDK process is not running")
        line = self.proc.stdout.readline()
        if not line:
            raise SdkError("DSH SDK process exited")
        try:
            message = json.loads(line)
        except ValueError as error:
            raise SdkError(f"invalid DSH SDK frame: {error}") from error
        if not isinstance(message, dict):
            raise SdkError("invalid DSH SDK frame")
        return message

    def _request(self, method: str, params: dict[str, Any] | None = None) -> Any:
        request_id = self.next_id
        self.next_id += 1
        payload: dict[str, Any] = {"jsonrpc": "2.0", "id": request_id, "method": method}
        if params is not None:
            payload["params"] = params
        self._write(payload)
        while True:
            if self.cancel.is_set():
                raise Cancelled()
            message = self._read()
            if message.get("id") != request_id:
                continue
            if "error" in message:
                error = message["error"]
                raise SdkError(error.get("message", str(error)) if isinstance(error, dict) else str(error))
            return message.get("result")

    def resume(self, session_id: str, cwd: str) -> None:
        self._ensure(cwd)
        if session_id in self.owned:
            return
        self._request("session/resume", {"sessionId": session_id})
        self.owned.add(session_id)

    def prompt(self, session_id: str, text: str, attachments: list[str] | None = None) -> Iterator[dict[str, Any]]:
        blocks: list[dict[str, Any]] = [{"type": "text", "text": text}]
        for path in attachments or []:
            blocks.append(attachment_content_block(path))
        self._request(
            "session/prompt",
            {"sessionId": session_id, "contentBlocks": blocks},
        )
        self.owned.add(session_id)
        deadline = time.monotonic() + PROMPT_TIMEOUT
        saw_assistant = False
        context_window = 0
        while True:
            if self.cancel.is_set():
                raise Cancelled()
            if time.monotonic() > deadline:
                raise SdkError("DSH turn timed out")
            message = self._read()
            if message.get("method") != "session.event":
                continue
            params = message.get("params") or {}
            if params.get("sessionId") != session_id:
                continue
            event = params.get("event") or {}
            kind = event.get("type")
            data = event.get("data")
            if kind == "step/start":
                yield {"kind": "activity", "text": "Thinking…"}
            elif kind == "request/context" and isinstance(data, dict):
                try:
                    context_window = int(data.get("contextWindow") or 0)
                except (TypeError, ValueError):
                    context_window = 0
                if context_window > 0:
                    yield {"kind": "context", "contextWindow": context_window}
            elif kind == "tool/call" and isinstance(data, dict):
                yield {"kind": "activity", "text": activity_label(str(data.get("name") or "tool"), data.get("arguments"))}
            elif kind == "tool/result":
                yield {"kind": "activity", "text": "Processing the result…"}
            elif kind == "assistant/message" and isinstance(data, dict):
                usage = data.get("usage")
                if isinstance(usage, dict):
                    yield {"kind": "usage", "usage": usage, "contextWindow": context_window}
                content = data.get("message", {}).get("content") if isinstance(data.get("message"), dict) else None
                body = text_blocks(content)
                if body:
                    saw_assistant = True
                    yield {"kind": "assistant", "text": body}
            elif kind == "turn/end":
                reason = data.get("reason") if isinstance(data, dict) else None
                if isinstance(reason, dict) and reason.get("kind") == "error":
                    error = reason.get("error")
                    if isinstance(error, dict):
                        raise SdkError(str(error.get("message") or "DSH turn failed"))
                    raise SdkError("DSH turn failed")
                yield {"kind": "done"}
                return
            elif kind == "session/status" and isinstance(data, dict) and data.get("status") == "idle" and saw_assistant:
                yield {"kind": "done"}
                return

    def stop(self) -> None:
        self.cancel.set()
        proc = self.proc
        if proc is None:
            return
        if proc.poll() is None:
            try:
                proc.terminate()
                proc.wait(timeout=2)
            except Exception:
                try:
                    proc.kill()
                except Exception:
                    pass
        self.proc = None
        self.initialized = False
        self.owned.clear()


def main() -> int:
    load_credential()
    sdk = DshSdk()
    sessions = list_sessions()
    fixed_default = default_session_id()
    active = next((item for item in sessions if item["id"] == fixed_default), None)

    def default_session(item: dict[str, Any]) -> bool:
        return "/agents/worktrees/" not in str(item.get("cwd") or "")

    if active is None:
        active = next((item for item in sessions if default_session(item)), sessions[0] if sessions else None)
    for item in sessions:
        if item["id"] == fixed_default:
            item["title"] = "Padilha"
    if active is not None and active["id"] == fixed_default:
        active["title"] = "Padilha"
        sessions.sort(key=lambda item: item["id"] != fixed_default)
    active_id = active["id"] if active else ""
    active_path = find_session(active_id) if active_id else None
    active_log = log_path(active_path) if active_path else None
    active_history = history(active_log) if active_log else []
    active_context = session_context(active_log)
    emit(
        {
            "type": "ready",
            "backend": "padilha-dsh",
            "models": [{"id": MODEL, "name": "DeepSeek Flash"}],
            "roots": [],
            "history": active_history,
            "sessionId": active_id,
            "sessionTitle": active["title"] if active else "",
            "sessionOwned": bool(active and active.get("owned")),
            "sessions": sessions,
            "defaultSessionId": fixed_default,
            "context": active_context,
            "reasoningEffort": reasoning_effort(),
        }
    )

    for raw in sys.stdin:
        try:
            request = json.loads(raw)
        except ValueError:
            continue
        if not isinstance(request, dict):
            continue
        command = request.get("cmd")
        if command == "list":
            emit({"type": "sessions", "sessions": list_sessions()})
        elif command == "subagents":
            parent = str(request.get("parent") or "")
            emit({"type": "subagents", "parent": parent, "agents": list_subagents(parent)})
        elif command == "load":
            session_id = str(request.get("sessionId") or "")
            path = find_session(session_id)
            if path is None:
                emit({"type": "error", "message": "DSH session not found"})
                continue
            summary = session_summary(path)
            log = log_path(path)
            if session_id == default_session_id():
                title = "Padilha"
            else:
                title = summary["title"] if summary else ""
            emit(
                {
                    "type": "history",
                    "sessionId": session_id,
                    "sessionTitle": title,
                    "sessionOwned": summary["owned"] if summary else False,
                    "history": history(log) if log else [],
                    "context": session_context(log),
                    "reasoningEffort": reasoning_effort(),
                }
            )
        elif command == "new_chat":
            emit({"type": "new", "sessionId": str(uuid.uuid4()), "sessionTitle": "", "sessionOwned": False})
        elif command == "chat":
            session_id = str(request.get("sessionId") or "")
            text = str(request.get("text") or "").strip()
            attachments = [str(path) for path in (request.get("attachments") or []) if str(path).strip()]
            if not text and not attachments:
                continue
            session_id, path = resolve_session(session_id or None)
            request_id = request.get("id")
            if not path:
                emit({"type": "session", "sessionId": session_id, "sessionTitle": text[:72], "sessionOwned": False})

            def worker(session_id: str = session_id, path: Path | None = path, text: str = text, attachments: list[str] = attachments, request_id: Any = request_id) -> None:
                try:
                    cwd = ""
                    if path is not None:
                        log = log_path(path)
                        if log is not None:
                            _title, cwd = first_user(log)
                    sdk.cancel.clear()
                    if path is not None:
                        sdk.resume(session_id, cwd or str(Path.home()))
                    else:
                        sdk._ensure(cwd or str(Path.home()))
                    last = ""
                    completed = False
                    for item in sdk.prompt(session_id, text, attachments):
                        if item["kind"] == "assistant":
                            last = item["text"]
                            emit({"type": "assistant", "id": request_id, "text": last})
                        elif item["kind"] == "usage":
                            emit({"type": "usage", "id": request_id, "usage": item.get("usage") or {}, "contextWindow": item.get("contextWindow") or 0})
                        elif item["kind"] == "context":
                            emit({"type": "context", "id": request_id, "contextWindow": item.get("contextWindow") or 0})
                        elif item["kind"] == "activity":
                            emit({"type": "activity", "id": request_id, "text": item["text"]})
                        elif item["kind"] == "done":
                            completed = True
                            emit({"type": "done", "id": request_id, "text": last, "stop": "complete"})
                            break
                    if not completed:
                        emit({"type": "done", "id": request_id, "text": last, "stop": "complete"})
                except Cancelled:
                    emit({"type": "done", "id": request_id, "text": "", "stop": "cancelled"})
                except Exception as error:
                    message = str(error)
                    if "already owned by an active write handle" in message:
                        message = "This session is open in dsh-tui. Close it there or start a new session."
                    emit({"type": "error", "id": request_id, "message": message})
                finally:
                    pass

            threading.Thread(target=worker, daemon=True).start()
        elif command == "cancel":
            sdk.stop()
        elif command == "shutdown":
            sdk.stop()
            return 0
    sdk.stop()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
