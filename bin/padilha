#!/usr/bin/env lua
-- padilha: the small commands the shell and the keybinds need.
--
--   padilha wallpaper -f PATH [--mode light|dark] [--variant NAME]
--   padilha wallpaper -r [DIR]        random from DIR (default: Pictures/wallpapers)
--   padilha wallpaper -p PATH         print the palette for PATH, write nothing
--   padilha scheme list               palettes for every variant, as JSON
--   padilha scheme get                the variant in use
--   padilha scheme set --variant NAME choose a variant and repaint
--
-- This replaced the Python CLI's wallpaper and scheme commands. The palette
-- itself is bin/padilha-theme; this is the state around it.

local function script_dir()
    -- Follow the symlink: packaged installs put the real files under
    -- /usr/lib/maria-padilha/bin and only links in /usr/bin.
    local raw = arg[0] or "padilha"
    local p = io.popen("readlink -f -- '" .. raw:gsub("'", "'\\''") .. "' 2>/dev/null")
    local resolved = p and p:read("*l")
    if p then
        p:close()
    end
    local path = (resolved and resolved ~= "") and resolved or raw
    return path:match("^(.*)/[^/]+$") or "."
end

local root = script_dir() .. "/.."
package.path = root .. "/lib/?.lua;" .. package.path

local json = require("json")
local schememod = require("scheme")
local desktop = require("desktop")
local seedmod = require("seed")
local themes = require("themes")

local function die(message)
    io.stderr:write("padilha: ", message, "\n")
    os.exit(1)
end

local function quote(s)
    return "'" .. tostring(s):gsub("'", "'\\''") .. "'"
end

local function usage()
    io.stderr:write([[
usage: padilha <command>

  wallpaper -f PATH [--mode M] [--variant V]   set the wallpaper and repaint
  wallpaper -r [DIR]                           pick one at random
  wallpaper -p PATH                            print the palette, write nothing
  scheme list                                  palettes for every variant (JSON)
  scheme get                                   the variant in use
  scheme set --variant NAME                    choose a variant and repaint
  theme mode light|dark                        repaint the current wallpaper
  theme list [--json]                          paired day/night themes
  theme use NAME                                apply a theme and make it active
  theme add --name NAME --day PATH --night PATH define a paired theme
  theme remove NAME                             delete a paired theme
  theme current                                 print the active theme id
  doctor                                       check the installed pieces
]])
    os.exit(2)
end

local args = { ... }
local command = table.remove(args, 1)
if not command then
    usage()
end

local function take_value(name)
    for i, a in ipairs(args) do
        if a == name then
            local value = args[i + 1]
            table.remove(args, i + 1)
            table.remove(args, i)
            return value
        end
    end
    return nil
end

local function flag(name)
    for i, a in ipairs(args) do
        if a == name then
            table.remove(args, i)
            return true
        end
    end
    return false
end

if command == "wallpaper" then
    local mode = take_value("--mode")
    local variant = take_value("--variant")
    local file = take_value("-f")
    local print_only = take_value("-p")
    local random = flag("-r")

    if file then
        local built, count, used = desktop.set_wallpaper(file, { mode = mode, variant = variant })
        if not built then
            die(count or ("cannot use " .. file))
        end
        io.write(string.format("%s: %s, %s, %d files\n", file, built.mode, used, count))
    elseif print_only then
        local built, err = desktop.describe(print_only, { mode = mode, variant = variant })
        if not built then
            die(err or ("cannot read " .. print_only))
        end
        io.write(json.encode(built))
    elseif random then
        local dir = args[1] or (desktop.pictures .. "/wallpapers")
        local p = io.popen("find " .. quote(dir) ..
            [[ -maxdepth 2 -type f \( -iname '*.jpg' -o -iname '*.jpeg' ]] ..
            [[ -o -iname '*.png' -o -iname '*.webp' \) | shuf -n 1]])
        local path = p and p:read("*l")
        if p then
            p:close()
        end
        if not path or path == "" then
            die("no wallpapers in " .. dir)
        end
        local built, count, used = desktop.set_wallpaper(path, { mode = mode, variant = variant })
        if not built then
            die(count or ("cannot use " .. path))
        end
        io.write(string.format("%s: %s, %s, %d files\n", path, built.mode, used, count))
    else
        usage()
    end
elseif command == "doctor" then
    local results = desktop.diagnostics()
    local bad, warned = 0, 0
    for _, r in ipairs(results) do
        local mark = "ok  "
        if r.level == "warn" then
            mark = "warn"
            warned = warned + 1
        elseif r.level == "fail" then
            mark = "FAIL"
            bad = bad + 1
        end
        io.write(("%s %-18s %s\n"):format(mark, r.name, r.detail))
    end
    if bad > 0 then
        io.write(("%d failures, %d warnings\n"):format(bad, warned))
        os.exit(1)
    end
    io.write(("%d warnings, nothing fatal\n"):format(warned))
elseif command == "theme" then
    local what = table.remove(args, 1)
    if what == "mode" then
        local mode = table.remove(args, 1)
        if mode ~= "light" and mode ~= "dark" then
            die("theme mode wants light or dark")
        end
        local wallpaper = desktop.current_wallpaper()
        if not wallpaper then
            die("no wallpaper set; run padilha wallpaper -f PATH first")
        end
        local built, count, used = desktop.set_wallpaper(wallpaper, { mode = mode, keep_theme = true })
        if not built then
            die(count or "could not repaint")
        end
        io.write(string.format("%s: %s, %d files\n", wallpaper, used, count))
    elseif what == "list" then
        local list, active = themes.list()
        if not list then
            die(active)
        end
        if flag("--json") then
            io.write(json.encode({ themes = list, active = active }))
        else
            for _, theme in ipairs(list) do
                io.write(string.format("%s%s\t%s\t%s\n",
                    theme.id == active and "* " or "  ", theme.name, theme.day, theme.night))
            end
        end
    elseif what == "current" then
        io.write(themes.active(), "\n")
    elseif what == "use" then
        local wanted = table.remove(args, 1)
        if not wanted then
            die("theme use needs a theme name")
        end
        local theme, err = themes.get(wanted)
        if not theme then
            die(err)
        end
        local period = themes.period()
        local image = period == "day" and theme.day or theme.night
        if not image or image == "" then
            die("theme has no " .. period .. " image")
        end
        local previous = themes.active()
        local ok, set_err = themes.set_active(theme.id)
        if not ok then
            die(set_err)
        end
        local built, count, used = desktop.set_wallpaper(image, {
            mode = period == "day" and "light" or "dark",
            keep_theme = true,
        })
        if not built then
            themes.set_active(previous ~= "" and previous or nil)
            die(count or "could not apply the theme")
        end
        io.write(string.format("%s: %s image, %s, %d files\n", theme.name, period, used, count))
    elseif what == "add" then
        local name = take_value("--name")
        local day = take_value("--day")
        local night = take_value("--night")
        if not name or not day or not night then
            die("theme add needs --name, --day and --night")
        end
        local id, err = themes.add(name, day, night)
        if not id then
            die(err)
        end
        io.write(id, "\n")
    elseif what == "remove" then
        local id = table.remove(args, 1)
        if not id then
            die("theme remove needs a theme id")
        end
        local ok, err = themes.remove(id)
        if not ok then
            die(err)
        end
    else
        usage()
    end
elseif command == "scheme" then
    local action = table.remove(args, 1)
    if action == "get" then
        io.write(desktop.variant(), "\n")
    elseif action == "set" then
        local variant = take_value("--variant")
        if not variant then
            die("scheme set needs --variant NAME")
        end
        local ok = false
        for _, name in ipairs(schememod.variants) do
            if name == variant then
                ok = true
            end
        end
        if not ok then
            die(("%q is not a variant (%s)"):format(variant, table.concat(schememod.variants, ", ")))
        end

        local wallpaper = desktop.current_wallpaper()
        if not wallpaper then
            die("no wallpaper set; run padilha wallpaper -f PATH first")
        end
        desktop.set_variant(variant)
        local built, count, used = desktop.set_wallpaper(wallpaper, { variant = variant, keep_theme = true })
        if not built then
            die(count or "could not repaint")
        end
        io.write(string.format("%s: %s, %d files\n", wallpaper, used, count))
    elseif action == "list" then
        -- Every variant, built from the current wallpaper, for the launcher's
        -- preview swatches. One sheet of colours, no files touched.
        local wallpaper = desktop.current_wallpaper()
        local seed_h, seed_c, mode
        if wallpaper then
            local info = seedmod.from_wallpaper(wallpaper)
            if info then
                seed_h, seed_c, mode = info.seed.h, info.seed.c, info.mode
            end
        end
        if not seed_h then
            -- No wallpaper yet: a neutral red so the picker still has colours.
            seed_h, seed_c, mode = 25, 55, "dark"
        end
        local out = {}
        for _, name in ipairs(schememod.variants) do
            local built = schememod.build(seed_h, seed_c, mode, name)
            out[name] = { colours = built.colours, mode = built.mode }
        end
        io.write(json.encode(out))
    else
        usage()
    end
else
    usage()
end
