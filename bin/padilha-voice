#!/usr/bin/python3
"""Desktop-neutral Padilha voice service.

The daemon owns a Unix socket and a single serialized speech queue. Any desktop
or toolkit can call it through the line-delimited JSON protocol below; PipeWire
does the playback, so there is no Qt, GTK or compositor dependency.

Output is implemented with Piper (or espeak-ng as a low-memory fallback).
Input is reserved for a later recognizer; `listen` deliberately reports that it
is not implemented yet instead of pretending to record.
"""

from __future__ import annotations

import argparse
import array
import difflib
import json
import os
import queue
import re
import shutil
import signal
import socket
import socketserver
import subprocess
import sys
import tempfile
import threading
import time
import unicodedata
import wave
from pathlib import Path
from typing import Any

HOME = Path.home()
DATA = Path(os.environ.get("PADILHA_VOICE_HOME", HOME / ".local/share/padilha/voice"))
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "padilha/voice.json"
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "padilha/voice.log"
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "padilha"
SOCKET = RUNTIME / "voice.sock"
MAX_TEXT = 12000
KOKORO_MODEL = DATA / "kokoro/kokoro-v1.0.onnx"
KOKORO_VOICES = DATA / "kokoro/voices-v1.0.bin"
KOKORO_VOICE = os.environ.get("PADILHA_VOICE_KOKORO_VOICE", "pf_dora")
KOKORO_SPEED = float(os.environ.get("PADILHA_VOICE_KOKORO_SPEED", "0.85"))
VOICE_CONFIG = CONFIG
KOKORO_MODEL_URL = (
    "https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.1/"
    "kokoro-v1.0.onnx"
)
KOKORO_VOICES_URL = (
    "https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.1/"
    "voices-v1.0.bin"
)
WHISPER_BIN = DATA / "whisper.cpp/build/bin/whisper-cli"
WHISPER_MODEL = DATA / "whisper-models/ggml-tiny.bin"
WAKE_THRESHOLD = int(os.environ.get("PADILHA_WAKE_THRESHOLD", "350"))
WAKE_PHRASE = os.environ.get("PADILHA_WAKE_PHRASE", "padilha")
PIPER_WHEEL = (
    "https://github.com/OHF-Voice/piper1-gpl/releases/download/v1.8.0/"
    "piper_tts-1.8.0-cp39-abi3-manylinux_2_17_x86_64.manylinux2014_x86_64."
    "manylinux_2_28_x86_64.whl"
)
PIPER_MODEL = (
    "https://huggingface.co/rhasspy/piper-voices/resolve/main/pt/pt_BR/faber/medium/"
    "pt_BR-faber-medium.onnx"
)
PIPER_MODEL_CONFIG = PIPER_MODEL + ".json"


def voice_settings() -> dict[str, Any]:
    data: dict[str, Any] = {}
    try:
        loaded = json.loads(VOICE_CONFIG.read_text(encoding="utf-8"))
        if isinstance(loaded, dict):
            data = loaded
    except (OSError, ValueError):
        pass
    voice = data.get("voice")
    if not isinstance(voice, str) or not voice:
        voice = KOKORO_VOICE
    try:
        speed = float(data.get("speed", KOKORO_SPEED))
    except (TypeError, ValueError):
        speed = KOKORO_SPEED
    speed = max(0.5, min(1.5, speed))
    return {"voice": voice, "speed": speed}


def save_voice_settings(voice: str | None = None, speed: float | None = None) -> dict[str, Any]:
    current = voice_settings()
    if voice is not None:
        current["voice"] = voice
    if speed is not None:
        current["speed"] = max(0.5, min(1.5, speed))
    VOICE_CONFIG.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    tmp = VOICE_CONFIG.with_suffix(".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(current, handle, ensure_ascii=False)
            handle.write("\n")
    finally:
        pass
    os.chmod(tmp, 0o600)
    os.replace(tmp, VOICE_CONFIG)
    return current


def plain_text(value: str) -> str:
    value = re.sub(r"```.*?```", " ", value, flags=re.S)
    value = re.sub(r"`([^`]*)`", r"\1", value)
    value = re.sub(r"!\[[^]]*\]\([^)]*\)", " ", value)
    value = re.sub(r"\[([^]]+)\]\([^)]*\)", r"\1", value)
    value = re.sub(r"https?://\S+", " ", value)
    value = re.sub(r"^\s{0,3}#{1,6}\s*", "", value, flags=re.M)
    value = re.sub(r"[*_~>#|]", " ", value)
    value = re.sub(r"\s+", " ", value)
    return value.strip()[:MAX_TEXT]


def reexec_venv() -> None:
    """Use the voice venv so the optional Kokoro Python runtime is importable."""
    if os.environ.get("PADILHA_VOICE_VENV") == "1":
        return
    python = DATA / "venv/bin/python"
    if not python.is_file():
        return
    try:
        if Path(sys.prefix).resolve() == (DATA / "venv").resolve():
            return
    except OSError:
        return
    os.environ["PADILHA_VOICE_VENV"] = "1"
    os.execv(str(python), [str(python), os.path.realpath(__file__), *sys.argv[1:]])


def kokoro_ready() -> bool:
    return (
        KOKORO_MODEL.is_file()
        and KOKORO_VOICES.is_file()
        and (DATA / "venv/bin/python").is_file()
    )


def piper_binary() -> Path | None:
    for candidate in (DATA / "venv/bin/piper", DATA / "piper/piper"):
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return candidate
    found = shutil.which("piper")
    return Path(found) if found else None


def voice_model() -> tuple[Path, int] | None:
    override = os.environ.get("PADILHA_VOICE_MODEL")
    candidates: list[Path] = []
    if override:
        candidates.append(Path(override).expanduser())
    candidates.extend(sorted((DATA / "models").glob("*.onnx")))
    for model in candidates:
        if not model.is_file():
            continue
        rate = 22050
        try:
            config = json.loads(model.with_suffix(model.suffix + ".json").read_text())
            rate = int(config.get("audio", {}).get("sample_rate", rate))
        except (OSError, ValueError, TypeError):
            pass
        return model, rate
    return None


def player_command(rate: int) -> list[str] | None:
    if shutil.which("pw-play"):
        return ["pw-play", "--raw", "--rate", str(rate), "--channels", "1", "--format", "s16", "-"]
    if shutil.which("paplay"):
        return ["paplay", "--raw", f"--rate={rate}", "--channels=1", "--format=s16le"]
    return None


class EngineError(RuntimeError):
    pass


class SpeechQueue:
    def __init__(self) -> None:
        self.jobs: queue.Queue[dict[str, Any]] = queue.Queue()
        self.cancel = threading.Event()
        self.current: dict[str, Any] | None = None
        self.procs: list[subprocess.Popen[bytes]] = []
        self.lock = threading.Lock()
        self.next_id = 1
        self.kokoro = None
        self.worker = threading.Thread(target=self._work, daemon=True)
        self.worker.start()

    def engine(self) -> str:
        if kokoro_ready():
            return "kokoro"
        if piper_binary() and voice_model():
            return "piper"
        if shutil.which("espeak-ng"):
            return "espeak-ng"
        return "unavailable"

    def speak(self, text: str, interrupt: bool = True) -> int:
        text = plain_text(text)
        if not text:
            raise EngineError("text is empty")
        if self.engine() == "unavailable":
            raise EngineError("no speech engine installed")
        with self.lock:
            job_id = self.next_id
            self.next_id += 1
            if interrupt:
                self._stop_locked()
                self._drain_locked()
            self.jobs.put({"id": job_id, "text": text})
        threading.Thread(target=self._wake, daemon=True).start()
        return job_id

    def _wake(self) -> None:
        # The worker blocks on the queue; nothing else is required, but keeping
        # this hook makes an interrupted queue wake immediately if a future
        # implementation replaces Queue with a condition.
        return

    def _drain_locked(self) -> None:
        while True:
            try:
                self.jobs.get_nowait()
            except queue.Empty:
                break

    def _work(self) -> None:
        while True:
            job = self.jobs.get()
            with self.lock:
                self.current = job
                self.cancel.clear()
            try:
                self._play(job["text"])
            except Exception as error:
                log(f"speech {job['id']} failed: {error}")
            finally:
                with self.lock:
                    self.current = None
                    self.procs = []

    def _play(self, text: str) -> None:
        engine = self.engine()
        if engine == "kokoro":
            self._play_kokoro(text)
        elif engine == "piper":
            self._play_piper(text)
        elif engine == "espeak-ng":
            self._play_espeak(text)
        else:
            raise EngineError("no speech engine installed")

    def _load_kokoro(self):
        import types

        import numpy as np
        from kokoro_onnx import Kokoro
        from kokoro_onnx.config import MAX_PHONEME_LENGTH, SAMPLE_RATE

        if self.kokoro is not None:
            return self.kokoro

        def create_audio(self, phonemes, voice, speed):
            if len(phonemes) > MAX_PHONEME_LENGTH:
                phonemes = phonemes[:MAX_PHONEME_LENGTH]
            tokens = np.array(self.tokenizer.tokenize(phonemes), dtype=np.int64)
            tokens = tokens[:MAX_PHONEME_LENGTH]
            voice = voice[len(tokens)]
            inputs = {
                "input_ids": [[0, *tokens, 0]],
                "style": np.array(voice, dtype=np.float32),
                "speed": np.array([speed], dtype=np.float32),
            }
            return self.sess.run(None, inputs)[0], SAMPLE_RATE

        import onnxruntime as ort

        original_session = ort.InferenceSession

        def no_spin_session(*args, **kwargs):
            # ONNX Runtime's CPU thread pool busy-waits after inference by
            # default (four threads spinning at ~25% each while idle). Disable
            # spinning for this session; it does not change the audio.
            options = kwargs.get("sess_options")
            if options is None:
                options = ort.SessionOptions()
                kwargs["sess_options"] = options
            for key in ("session.intra_op.allow_spinning", "session.inter_op.allow_spinning"):
                try:
                    options.add_session_config_entry(key, "0")
                except Exception:
                    pass
            return original_session(*args, **kwargs)

        ort.InferenceSession = no_spin_session
        try:
            instance = Kokoro(str(KOKORO_MODEL), str(KOKORO_VOICES))
        finally:
            ort.InferenceSession = original_session
        instance._create_audio = types.MethodType(create_audio, instance)
        self.kokoro = instance
        return instance

    def _play_kokoro(self, text: str) -> None:
        import numpy as np

        kokoro = self._load_kokoro()
        settings = voice_settings()
        samples, rate = kokoro.create(
            text,
            voice=settings["voice"],
            speed=settings["speed"],
            lang="pt-br",
        )
        if self.cancel.is_set():
            return
        player = player_command(rate)
        if player is None:
            raise EngineError("PipeWire playback command is missing")
        proc = subprocess.Popen(
            player,
            stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        with self.lock:
            self.procs = [proc]
        assert proc.stdin is not None
        raw = (np.clip(samples, -1.0, 1.0) * 32767).astype("<i2").tobytes()
        proc.stdin.write(raw)
        proc.stdin.close()
        proc.wait()

    def _play_piper(self, text: str) -> None:
        binary = piper_binary()
        model_info = voice_model()
        if binary is None or model_info is None:
            raise EngineError("Piper or its voice model is missing")
        model, rate = model_info
        player = player_command(rate)
        if player is None:
            raise EngineError("PipeWire playback command is missing")
        help_text = ""
        try:
            help_text = subprocess.run([str(binary), "--help"], capture_output=True, text=True, timeout=5).stdout
        except Exception:
            pass
        raw_flag = "--output-raw" if "--output-raw" in help_text else "--output_raw"
        piper = subprocess.Popen(
            [str(binary), "-m", str(model), raw_flag],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        assert piper.stdin is not None and piper.stdout is not None
        player_proc = subprocess.Popen(
            player,
            stdin=piper.stdout,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        piper.stdout.close()
        with self.lock:
            self.procs = [piper, player_proc]
        try:
            piper.stdin.write(text.encode("utf-8"))
            piper.stdin.close()
        except BrokenPipeError:
            pass
        piper.wait()
        player_proc.wait()

    def _play_espeak(self, text: str) -> None:
        espeak = shutil.which("espeak-ng")
        player = shutil.which("pw-play")
        if not espeak or not player:
            raise EngineError("espeak-ng or pw-play is missing")
        espeak_proc = subprocess.Popen(
            [espeak, "--stdout", "-v", "pt-br", text],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        assert espeak_proc.stdout is not None
        player_proc = subprocess.Popen(
            [player, "-"],
            stdin=espeak_proc.stdout,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        espeak_proc.stdout.close()
        with self.lock:
            self.procs = [espeak_proc, player_proc]
        espeak_proc.wait()
        player_proc.wait()

    def _stop_locked(self) -> None:
        self.cancel.set()
        for proc in list(self.procs):
            if proc.poll() is None:
                try:
                    os.killpg(proc.pid, signal.SIGTERM)
                except OSError:
                    try:
                        proc.terminate()
                    except OSError:
                        pass
        for proc in list(self.procs):
            try:
                proc.wait(timeout=1)
            except Exception:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except OSError:
                    pass

    def stop(self) -> None:
        with self.lock:
            self._stop_locked()
            self._drain_locked()

    def status(self) -> dict[str, Any]:
        with self.lock:
            return {
                "engine": self.engine(),
                "speaking": self.current is not None,
                "current": self.current["id"] if self.current else None,
                "queued": self.jobs.qsize(),
                "socket": str(SOCKET),
            }


SPEECH = SpeechQueue()


def emit(payload: dict[str, Any]) -> None:
    sys.stdout.write(json.dumps(payload, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def log(message: str) -> None:
    try:
        STATE.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        with STATE.open("a", encoding="utf-8") as handle:
            handle.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {message}\n")
    except OSError:
        pass


def send(conn: socket.socket, payload: dict[str, Any]) -> None:
    conn.sendall((json.dumps(payload, ensure_ascii=False) + "\n").encode("utf-8"))


class Handler(socketserver.StreamRequestHandler):
    def handle(self) -> None:
        for raw in self.rfile:
            try:
                request = json.loads(raw)
            except ValueError:
                send(self.request, {"ok": False, "error": "invalid_json"})
                continue
            if not isinstance(request, dict):
                send(self.request, {"ok": False, "error": "invalid_request"})
                continue
            command = request.get("cmd")
            try:
                if command == "speak":
                    text = str(request.get("text") or "")
                    job_id = SPEECH.speak(text, interrupt=bool(request.get("interrupt", True)))
                    send(self.request, {"ok": True, "id": job_id, **SPEECH.status()})
                elif command == "stop":
                    SPEECH.stop()
                    send(self.request, {"ok": True, **SPEECH.status()})
                elif command == "status":
                    send(self.request, {"ok": True, **SPEECH.status()})
                elif command == "listen":
                    send(self.request, {"ok": False, "error": "stt_not_implemented", "message": "Speech input is reserved for a later recognizer."})
                elif command == "shutdown":
                    send(self.request, {"ok": True})
                    threading.Thread(target=self.server.shutdown, daemon=True).start()
                    return
                else:
                    send(self.request, {"ok": False, "error": "unknown_command"})
            except EngineError as error:
                send(self.request, {"ok": False, "error": str(error)})
            except Exception as error:
                log(f"request failed: {error}")
                send(self.request, {"ok": False, "error": "internal_error"})


class Server(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True


def daemon() -> int:
    RUNTIME.mkdir(mode=0o700, parents=True, exist_ok=True)
    if SOCKET.exists():
        probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            probe.settimeout(0.3)
            probe.connect(str(SOCKET))
            probe.close()
            print("padilha-voice: daemon already running", file=sys.stderr)
            return 0
        except OSError:
            SOCKET.unlink(missing_ok=True)
    server = Server(str(SOCKET), Handler)
    os.chmod(SOCKET, 0o600)
    log(f"daemon started engine={SPEECH.engine()}")

    def stop(_signum: int, _frame: Any) -> None:
        SPEECH.stop()
        threading.Thread(target=server.shutdown, daemon=True).start()

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        server.serve_forever(poll_interval=0.25)
    finally:
        SPEECH.stop()
        server.server_close()
        SOCKET.unlink(missing_ok=True)
    return 0


def normalize_words(text: str) -> list[str]:
    value = unicodedata.normalize("NFKD", text)
    value = "".join(char for char in value if not unicodedata.combining(char))
    value = re.sub(r"[^a-z0-9]+", " ", value.lower())
    return [word for word in value.split() if word]


def wake_match(text: str) -> tuple[bool, str]:
    words = normalize_words(text)
    target = normalize_words(WAKE_PHRASE)
    target_word = target[0] if target else "padilha"
    for index, word in enumerate(words):
        ratio = difflib.SequenceMatcher(None, target_word, word).ratio()
        if word.startswith("pad") and ratio >= 0.70:
            remainder = " ".join(words[index + 1:]).strip()
            return True, remainder
        if ratio >= 0.86:
            remainder = " ".join(words[index + 1:]).strip()
            return True, remainder
    return False, ""


def whisper_available() -> bool:
    return WHISPER_BIN.is_file() and os.access(WHISPER_BIN, os.X_OK) and WHISPER_MODEL.is_file()


def transcribe_wav(path: Path) -> str:
    if not whisper_available():
        raise EngineError("Whisper wake model is missing; run padilha-voice setup-wake")
    result = subprocess.run(
        [
            str(WHISPER_BIN),
            "-m",
            str(WHISPER_MODEL),
            "-f",
            str(path),
            "-l",
            "pt",
            "-nt",
            "-np",
        ],
        capture_output=True,
        text=True,
        timeout=60,
    )
    return " ".join(result.stdout.split()).strip()


def write_pcm_wav(path: Path, pcm: bytes) -> None:
    with wave.open(str(path), "wb") as handle:
        handle.setnchannels(1)
        handle.setsampwidth(2)
        handle.setframerate(16000)
        handle.writeframes(pcm)


def rms_level(chunk: bytes) -> float:
    samples = array.array("h")
    samples.frombytes(chunk[: len(chunk) - (len(chunk) % 2)])
    if not samples:
        return 0.0
    return (sum(value * value for value in samples) / len(samples)) ** 0.5


def listen(events: bool, wav_path: str | None = None, once: bool = False) -> int:
    """Listen for the wake phrase and then one command utterance, or capture one utterance."""
    if not whisper_available():
        print("padilha-voice: Whisper wake model is missing; run padilha-voice setup-wake", file=sys.stderr)
        return 1
    emit({"event": "ready", "engine": "whisper", "phrase": WAKE_PHRASE})
    if wav_path:
        path = Path(wav_path)
        try:
            text = transcribe_wav(path)
        except Exception as error:
            emit({"event": "error", "message": str(error)})
            return 1
        is_wake, remainder = wake_match(text)
        if is_wake:
            emit({"event": "wake", "phrase": text})
            if remainder:
                emit({"event": "final", "text": remainder})
        else:
            emit({"event": "final", "text": text})
        return 0

    capture_cmd = shutil.which("parec")
    if capture_cmd:
        capture = [capture_cmd, "--format=s16le", "--rate=16000", "--channels=1", "--latency-msec=50"]
    else:
        capture_cmd = shutil.which("pw-record")
        if not capture_cmd:
            emit({"event": "error", "message": "parec/pw-record is missing"})
            return 1
        capture = [capture_cmd, "--format=s16", "--rate=16000", "--channels=1", "-"]
    process = subprocess.Popen(
        capture,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    assert process.stdout is not None
    state = "command" if once else "wake"
    in_speech = False
    silence_chunks = 0
    utterance = bytearray()
    preroll: list[bytes] = []
    try:
        while True:
            chunk = process.stdout.read(3200)
            if not chunk:
                break
            if not in_speech:
                preroll.append(chunk)
                if len(preroll) > 4:
                    preroll.pop(0)
                if rms_level(chunk) < WAKE_THRESHOLD:
                    continue
                in_speech = True
                silence_chunks = 0
                utterance = bytearray(b"".join(preroll))
                preroll.clear()
                continue
            utterance.extend(chunk)
            if rms_level(chunk) < WAKE_THRESHOLD:
                silence_chunks += 1
            else:
                silence_chunks = 0
            if silence_chunks < 8 and len(utterance) < 16000 * 2 * 12:
                continue

            in_speech = False
            silence_chunks = 0
            if len(utterance) < 3200 * 3:
                utterance.clear()
                continue
            with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as handle:
                temp_path = Path(handle.name)
            try:
                write_pcm_wav(temp_path, bytes(utterance))
                text = transcribe_wav(temp_path)
            except Exception as error:
                emit({"event": "error", "message": str(error)})
                utterance.clear()
                continue
            finally:
                temp_path.unlink(missing_ok=True)
            utterance.clear()
            if not text:
                continue
            if state == "wake":
                is_wake, remainder = wake_match(text)
                if not is_wake:
                    continue
                emit({"event": "wake", "phrase": text})
                if remainder and len(remainder) > 2:
                    emit({"event": "final", "text": remainder})
                    state = "wake"
                else:
                    state = "command"
            elif state == "command":
                emit({"event": "final", "text": text})
                if once:
                    break
                state = "wake"
    finally:
        try:
            os.killpg(process.pid, signal.SIGTERM)
        except OSError:
            pass
        try:
            process.wait(timeout=2)
        except Exception:
            process.kill()
    return 0


def setup_wake(force: bool = False) -> int:
    """Build Whisper and fetch the tiny Portuguese-capable model."""
    if not force and whisper_available():
        print("padilha-voice: wake model ready")
        return 0
    DATA.mkdir(mode=0o700, parents=True, exist_ok=True)
    source = DATA / "whisper.cpp"
    if force or not (source / "CMakeLists.txt").is_file():
        subprocess.run(
            ["git", "clone", "--depth", "1", "https://github.com/ggerganov/whisper.cpp", str(source)],
            check=True,
        )
    subprocess.run(
        ["cmake", "-S", str(source), "-B", str(source / "build"), "-DCMAKE_BUILD_TYPE=Release", "-DWHISPER_BUILD_TESTS=OFF", "-DWHISPER_BUILD_EXAMPLES=ON"],
        check=True,
    )
    subprocess.run(["cmake", "--build", str(source / "build"), "-j4"], check=True)
    (DATA / "whisper-models").mkdir(mode=0o700, parents=True, exist_ok=True)
    if force or not WHISPER_MODEL.is_file():
        subprocess.run(
            ["curl", "-L", "--fail", "--max-time", "600", "-o", str(WHISPER_MODEL), "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-tiny.bin"],
            check=True,
        )
    print("padilha-voice: wake model ready")
    return 0


def setup(force: bool = False) -> int:
    """Install the local Piper runtime and PT-BR voice under the user's data."""
    binary = DATA / "venv/bin/piper"
    model = DATA / "models/pt_BR-faber-medium.onnx"
    if (
        not force
        and binary.is_file()
        and model.is_file()
        and KOKORO_MODEL.is_file()
        and KOKORO_VOICES.is_file()
    ):
        print("padilha-voice: ready (Kokoro + Piper fallback)")
        return 0
    DATA.mkdir(mode=0o700, parents=True, exist_ok=True)
    (DATA / "models").mkdir(mode=0o700, parents=True, exist_ok=True)
    venv = DATA / "venv"
    if force or not (venv / "bin/python").is_file():
        subprocess.run([sys.executable, "-m", "venv", str(venv)], check=True)
    wheel = DATA / "piper.whl"
    if force or not wheel.is_file():
        print("padilha-voice: downloading Piper runtime", flush=True)
        subprocess.run(["curl", "-L", "--fail", "--max-time", "300", "-o", str(wheel), PIPER_WHEEL], check=True)
    print("padilha-voice: installing Piper", flush=True)
    subprocess.run([str(venv / "bin/pip"), "install", "--quiet", str(wheel)], check=True)
    if force or not model.is_file():
        print("padilha-voice: downloading pt-BR fallback voice", flush=True)
        subprocess.run(["curl", "-L", "--fail", "--max-time", "300", "-o", str(model), PIPER_MODEL], check=True)
        subprocess.run(
            ["curl", "-L", "--fail", "--max-time", "60", "-o", str(model) + ".json", PIPER_MODEL_CONFIG],
            check=True,
        )
    print("padilha-voice: installing Kokoro", flush=True)
    subprocess.run([str(venv / "bin/pip"), "install", "--quiet", "kokoro-onnx"], check=True)
    KOKORO_MODEL.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if force or not KOKORO_MODEL.is_file():
        print("padilha-voice: downloading Maria voice", flush=True)
        subprocess.run(["curl", "-L", "--fail", "--max-time", "600", "-o", str(KOKORO_MODEL), KOKORO_MODEL_URL], check=True)
    if force or not KOKORO_VOICES.is_file():
        subprocess.run(["curl", "-L", "--fail", "--max-time", "300", "-o", str(KOKORO_VOICES), KOKORO_VOICES_URL], check=True)
    print("padilha-voice: ready")
    return 0


def request(payload: dict[str, Any], timeout: float = 5.0) -> dict[str, Any]:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(timeout)
        client.connect(str(SOCKET))
        client.sendall((json.dumps(payload, ensure_ascii=False) + "\n").encode("utf-8"))
        data = b""
        while b"\n" not in data:
            chunk = client.recv(65536)
            if not chunk:
                break
            data += chunk
    try:
        return json.loads(data.split(b"\n", 1)[0])
    except ValueError as error:
        raise SystemExit(f"padilha-voice: invalid daemon reply: {error}")


def ensure_daemon() -> None:
    if SOCKET.exists():
        try:
            request({"cmd": "status"}, timeout=0.5)
            return
        except (OSError, SystemExit):
            pass
    if os.environ.get("PADILHA_VOICE_NO_AUTOSTART") == "1":
        raise SystemExit("padilha-voice: daemon is not running")
    RUNTIME.mkdir(mode=0o700, parents=True, exist_ok=True)
    log_file = STATE
    log_file.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    subprocess.Popen(
        [sys.executable, os.path.realpath(__file__), "daemon"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    for _ in range(30):
        time.sleep(0.1)
        if SOCKET.exists():
            try:
                request({"cmd": "status"}, timeout=0.5)
                return
            except (OSError, SystemExit):
                pass
    raise SystemExit("padilha-voice: daemon did not start")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="padilha-voice", description="Padilha desktop voice service")
    sub = parser.add_subparsers(dest="command", required=True)
    speak = sub.add_parser("speak", help="queue text for speech")
    speak.add_argument("text", nargs="?", help="text to speak; use - or omit to read stdin")
    speak.add_argument("--no-interrupt", action="store_true", help="append instead of interrupting")
    speak.add_argument("--wait", action="store_true", help="wait until this utterance is spoken")
    sub.add_parser("stop", help="stop speech and clear the queue")
    sub.add_parser("status", help="show daemon state")
    sub.add_parser("voices", help="show the selected engine and model")
    sub.add_parser("config", help="print the saved voice preferences")
    listen_parser = sub.add_parser("listen", help="listen for the Padilha wake phrase")
    listen_parser.add_argument("--events", action="store_true", help="emit JSON events")
    listen_parser.add_argument("--wav", help="test one WAV file instead of the microphone")
    listen_parser.add_argument("--once", action="store_true", help="capture one utterance without the wake phrase")
    setup_wake_parser = sub.add_parser("setup-wake", help="build Whisper and fetch the tiny wake model")
    setup_wake_parser.add_argument("--force", action="store_true")
    set_voice_parser = sub.add_parser("set-voice", help="select the Kokoro voice id")
    set_voice_parser.add_argument("voice")
    set_speed_parser = sub.add_parser("set-speed", help="set Kokoro speech speed (0.5-1.5)")
    set_speed_parser.add_argument("speed", type=float)
    setup_parser = sub.add_parser("setup", help="download the local Piper runtime and voice")
    setup_parser.add_argument("--force", action="store_true")
    sub.add_parser("daemon", help="run the service in the foreground")
    args = parser.parse_args(argv)

    if args.command != "setup":
        reexec_venv()

    if args.command == "daemon":
        return daemon()
    if args.command == "setup":
        return setup(args.force)
    if args.command == "setup-wake":
        return setup_wake(args.force)
    if args.command == "listen":
        return listen(args.events, args.wav, args.once)
    if args.command == "voices":
        info = voice_model()
        print(json.dumps({
            "engine": SPEECH.engine(),
            "piper": str(piper_binary()) if piper_binary() else None,
            "model": str(KOKORO_MODEL) if kokoro_ready() else (str(info[0]) if info else None),
            "sample_rate": 24000 if kokoro_ready() else (info[1] if info else None),
            "piper_model": str(info[0]) if info else None,
            "kokoro_voice": voice_settings()["voice"] if kokoro_ready() else None,
            "kokoro_speed": voice_settings()["speed"] if kokoro_ready() else None,
            "espeak_ng": shutil.which("espeak-ng"),
        }, indent=2, ensure_ascii=False))
        return 0

    if args.command == "config":
        print(json.dumps({
            **voice_settings(),
            "engine": SPEECH.engine(),
            "voice_available": kokoro_ready(),
        }, ensure_ascii=False))
        return 0
    if args.command == "set-voice":
        print(json.dumps(save_voice_settings(voice=args.voice), ensure_ascii=False))
        return 0
    if args.command == "set-speed":
        print(json.dumps(save_voice_settings(speed=args.speed), ensure_ascii=False))
        return 0

    ensure_daemon()
    if args.command == "status":
        print(json.dumps(request({"cmd": "status"}), indent=2, ensure_ascii=False))
        return 0
    if args.command == "stop":
        print(json.dumps(request({"cmd": "stop"}), ensure_ascii=False))
        return 0
    if args.command == "speak":
        if args.text and args.text != "-":
            text = args.text
        else:
            text = sys.stdin.read()
        response = request({"cmd": "speak", "text": text, "interrupt": not args.no_interrupt})
        if not response.get("ok"):
            raise SystemExit(f"padilha-voice: {response.get('error', 'speech failed')}")
        if args.wait:
            deadline = time.monotonic() + 120
            while time.monotonic() < deadline:
                time.sleep(0.2)
                status = request({"cmd": "status"})
                if status.get("current") != response.get("id") and status.get("queued", 0) == 0:
                    break
        print(json.dumps(response, ensure_ascii=False))
        return 0
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
