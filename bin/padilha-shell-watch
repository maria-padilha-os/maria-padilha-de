#!/bin/sh
# Keep the Quickshell instance alive. Quickshell crashes used to leave the
# desktop with only client windows; this restarts it with a bounded backoff and
# leaves a log instead of silently staying down.
#
# Start from execs.lua (in the Hyprland environment), not the agent sandbox.
set -u

self=$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")
root=$(CDPATH='' cd -- "$(dirname -- "$self")/.." && pwd)
runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
# Maria Padilha is primary; keep using the old tree only while it is the one that
# exists (the same rule the shell uses for its config directory).
state="$state_home/padilha"
if [ ! -d "$state" ] && [ -d "$state_home/lilith" ]; then
    state="$state_home/lilith"
fi
log="$state/shell-watch.log"
marker="$runtime/padilha-shell-reload"
legacy_marker="$runtime/lilith-shell-reload"

mkdir -p "$state" "$runtime"
exec 9>"$runtime/padilha-shell-watch.lock"
flock -n 9 || exit 0

say() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$log"
}

# Let the normal session startup finish before watching it.
sleep 20
failures=0
down=0

while :; do
    sleep 10

    if qs -c caelestia ipc show >/dev/null 2>&1; then
        failures=0
        down=0
        continue
    fi

    # A deliberate `padilha-reload` is allowed to take the shell down briefly.
    # The old marker name is still accepted during the rename transition.
    recent=0
    for m in "$marker" "$legacy_marker"; do
        [ -f "$m" ] || continue
        age=$(( $(date +%s) - $(stat -c %Y "$m" 2>/dev/null || echo 0) ))
        [ "$age" -lt 30 ] && recent=1
    done
    if [ "$recent" -eq 1 ]; then
        continue
    fi

    down=$((down + 10))
    if pgrep -x quickshell >/dev/null 2>&1; then
        # A process exists but its IPC is gone: give it time, then replace it.
        if [ "$down" -ge 120 ]; then
            say "quickshell alive but unresponsive; terminating it"
            pkill -x quickshell >/dev/null 2>&1 || true
            sleep 2
        else
            continue
        fi
    fi

    failures=$((failures + 1))
    if [ "$failures" -gt 5 ]; then
        say "giving up after 5 restart attempts; fix the shell and restart this watchdog"
        exit 1
    fi

    delay=$((failures * 5))
    say "shell is down; restarting in ${delay}s (attempt $failures)"
    sleep "$delay"
    setsid "$root/bin/padilha-session" >>"$log" 2>&1 < /dev/null &
    sleep 15
done
