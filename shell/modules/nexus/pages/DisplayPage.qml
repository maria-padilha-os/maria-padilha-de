import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Caelestia.Config
import Caelestia.I18n
import qs.components
import qs.components.controls
import qs.services
import qs.utils
import qs.modules.nexus.common

PageBase {
    id: root

    readonly property var monitorNames: (Hypr.monitors?.values ?? []).map(m => m.name)
    property string monitorName

    // Follows the selected output; falls back to the screen the window is on.
    readonly property var hyprMonitor: {
        const list = Hypr.monitors?.values ?? [];
        return list.find(m => m.name === root.monitorName) ?? Hypr.monitorFor(root.nState.screen);
    }
    readonly property var brightnessMonitor: root.monitorName ? Brightness.getMonitor(root.monitorName) : Brightness.getMonitorForScreen(root.nState.screen)

    // Every mode Hyprland reports for this output; applying one of these is
    // safe, since they come from the monitor itself.
    readonly property var monitorModes: root.hyprMonitor?.lastIpcObject?.availableModes ?? []
    readonly property string currentMode: root.hyprMonitor ? `${root.hyprMonitor.width}x${root.hyprMonitor.height}@${Number(root.hyprMonitor.refreshRate ?? 0).toFixed(2)}` : ""
    readonly property list<real> scales: [1, 1.25, 1.5, 1.75, 2]

    title: Tr.tr("Display")

    // Runtime-only on purpose: the compositor keeps it until the next reload.
    // The same rule is written to ~/.config/lilith/monitors.lua, which the
    // Hyprland config sources, so the choice survives that reload.
    function applyMonitor(mode: string, scale: real): void {
        const m = root.hyprMonitor;
        if (!m || !mode)
            return;

        applyProc.command = [
            "hyprctl", "keyword", "monitor",
            `${m.name},${mode},${m.x ?? 0}x${m.y ?? 0},${scale},${m.transform ?? 0}`
        ];
        applyProc.running = true;
        root.persistMonitors(m.name, mode, scale);
    }

    // Rewrite the whole saved layout from the live monitors, with the edited
    // output replaced by the requested mode/scale. Hyprland owns the file
    // format; anything hand-written there is overwritten by design.
    function persistMonitors(name: string, mode: string, scale: real): void {
        const rules = [];
        const monitors = Hypr.monitors?.values ?? [];

        for (let i = 0; i < monitors.length; i++) {
            const m = monitors[i];
            if (m.name === name)
                continue;
            rules.push(`    { output = "${m.name}", mode = "${m.width}x${m.height}@${Number(m.refreshRate ?? 0).toFixed(2)}", position = "${m.x ?? 0}x${m.y ?? 0}", scale = ${m.scale ?? 1}, transform = ${m.transform ?? 0} },`);
        }

        const current = root.hyprMonitor;
        rules.unshift(`    { output = "${name}", mode = "${mode}", position = "${current?.x ?? 0}x${current?.y ?? 0}", scale = ${scale}, transform = ${current?.transform ?? 0} },`);

        const content = `-- Generated by the Lilith settings app. Edits are overwritten.\nreturn {\n${rules.join("\n")}\n}\n`;
        persistProc.command = [
            "sh", "-c",
            "mkdir -p \"$(dirname \"$2\")\" && printf '%s' \"$1\" > \"$2\"",
            "sh", content, `${Paths.home}/.config/lilith/monitors.lua`
        ];
        persistProc.running = true;
    }

    Component.onCompleted: root.monitorName = Hypr.monitorFor(root.nState.screen)?.name ?? root.monitorNames[0] ?? ""

    ColumnLayout {
        anchors.horizontalCenter: parent.horizontalCenter
        anchors.top: parent.top
        width: root.cappedWidth
        spacing: Tokens.spacing.extraSmall / 2

        SectionHeader {
            first: true
            text: Tr.tr("Brightness")
        }

        SliderRow {
            first: true
            last: true
            icon: "brightness_6"
            label: Tr.tr("Brightness")
            valueLabel: `${Math.round(value * 100)}%`
            value: root.brightnessMonitor?.brightness ?? 0
            enabled: root.brightnessMonitor !== null
            onMoved: value => root.brightnessMonitor?.setBrightness(value)
        }

        SectionHeader {
            text: Tr.tr("Night light")
        }

        ToggleRow {
            first: true
            text: Tr.tr("Night light")
            subtext: Tr.tr("Warm tint after sunset")
            checked: NightLight.active
            disabled: NightLight.busy
            onToggled: NightLight.setActive(checked)
        }

        ToggleRow {
            text: Tr.tr("Automatic schedule")
            subtext: Tr.tr("Switch by the hours below")
            checked: GlobalConfig.services.nightLightAuto
            onToggled: {
                GlobalConfig.services.nightLightAuto = checked;
                NightLight.tick();
            }
        }

        StepperRow {
            label: Tr.tr("Switch on at")
            subtext: Tr.tr("Hour of the day")
            value: NightLight.hourOf(GlobalConfig.services.nightLightOn)
            from: 0
            to: 23
            stepSize: 1
            enabled: GlobalConfig.services.nightLightAuto
            onMoved: value => GlobalConfig.services.nightLightOn = `${Math.round(value)}:00`
        }

        StepperRow {
            last: true
            label: Tr.tr("Switch off at")
            subtext: Tr.tr("Hour of the day")
            value: NightLight.hourOf(GlobalConfig.services.nightLightOff)
            from: 0
            to: 23
            stepSize: 1
            enabled: GlobalConfig.services.nightLightAuto
            onMoved: value => GlobalConfig.services.nightLightOff = `${Math.round(value)}:00`
        }

        SectionHeader {
            text: Tr.tr("Monitor")
        }

        SelectRow {
            id: monitorSelect

            visible: root.monitorNames.length > 1
            first: true
            label: Tr.tr("Output")
            subtext: Tr.tr("Monitor this page controls")
            menuItems: monitorVariants.instances
            active: menuItems.find(i => i.text === root.monitorName) ?? null
            fallbackText: root.monitorName || "—"
            fallbackIcon: "monitor"
            onSelected: item => root.monitorName = item.text
        }

        InfoRow {
            first: !monitorSelect.visible
            label: Tr.tr("Output")
            value: root.hyprMonitor?.name ?? "—"
        }

        SelectRow {
            label: Tr.tr("Mode")
            subtext: Tr.tr("Resolution and refresh rate")
            menuItems: modeVariants.instances
            active: menuItems.find(i => i.text === root.currentMode) ?? null
            fallbackText: root.currentMode || "—"
            fallbackIcon: "monitor"
            onSelected: item => root.applyMonitor(item.text, root.hyprMonitor?.scale ?? 1)
        }

        SelectRow {
            last: true
            label: Tr.tr("Scale")
            subtext: Tr.tr("Interface scale for this output")
            menuItems: scaleVariants.instances
            active: menuItems.find(i => i.text === `${Math.round((root.hyprMonitor?.scale ?? 1) * 100)}%`) ?? null
            fallbackText: `${Math.round((root.hyprMonitor?.scale ?? 1) * 100)}%`
            fallbackIcon: "zoom_in"
            onSelected: item => root.applyMonitor(root.currentMode, parseFloat(item.text) / 100)
        }

        // Non-visual helpers live inside the layout's data property: PageBase's
        // default property is an Item, so they cannot sit at page level.
        Variants {
            id: monitorVariants

            model: root.monitorNames

            MenuItem {
                required property string modelData

                text: modelData
                icon: text === root.monitorName ? "check" : ""
                activeIcon: "monitor"
            }
        }

        Variants {
            id: modeVariants

            model: root.monitorModes

            MenuItem {
                required property string modelData

                text: modelData.replace("Hz", "")
                icon: text === root.currentMode ? "check" : ""
                activeIcon: "monitor"
            }
        }

        Variants {
            id: scaleVariants

            model: root.scales

            MenuItem {
                required property real modelData

                text: `${Math.round(modelData * 100)}%`
                icon: text === `${Math.round((root.hyprMonitor?.scale ?? 1) * 100)}%` ? "check" : ""
                activeIcon: "zoom_in"
            }
        }

        Process {
            id: applyProc
        }

        Process {
            id: persistProc
        }
    }
}
