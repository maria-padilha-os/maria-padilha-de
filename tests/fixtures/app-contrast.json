        { "name": "selected row text", "fg": "onSurface", "bg": "surface", "minimum": 4.5 },
        { "name": "selected row hover text", "fg": "onSurface", "bg": "primaryContainer", "minimum": 4.5 },
        { "name": "elevated highlight text", "fg": "onSurface", "bg": "surfaceContainerHighest", "minimum": 4.5 },
        { "name": "notification text", "fg": "onSurface", "bg": "surfaceContainerHigh", "minimum": 4.5 },
        { "name": "error notification text", "fg": "onSurface", "bg": "errorContainer", "minimum": 4.5 },
        { "name": "active tab text", "fg": "onSurface", "bg": "surfaceContainer", "minimum": 4.5 },
