    "spicetify": {
      "templates": [
        "share/templates/spicetify-dark.ini",
        "share/templates/spicetify-light.ini"
      ],
      "destination": "spicetify/Themes/caelestia/color.ini",
      "templateName": "spicetify-{mode}.ini",
      "sameKeys": true,
      "required": [
        "[caelestia]", "selected-row", "highlight", "highlight-elevated",
        "notification", "notification-error", "equalizer", "accent",
        "Optional", "Spicetify", "Spotify"
      ],
      "pairs": [
        { "name": "main text", "fg": "onSurface", "bg": "surfaceContainer", "minimum": 4.5 },
        { "name": "main text on light surface", "fg": "onSurface", "bg": "surface", "minimum": 4.5 },
        { "name": "subtext", "fg": "onSurfaceVariant", "bg": "surfaceContainer", "minimum": 4.5 },
        { "name": "subtext on light surface", "fg": "onSurfaceVariant", "bg": "surface", "minimum": 4.5 },
        { "name": "card text", "fg": "onSurface", "bg": "surfaceContainerHigh", "minimum": 4.5 },
        { "name": "card text on light card", "fg": "onSurface", "bg": "surfaceContainer", "minimum": 4.5 },
        { "name": "player text", "fg": "onSurface", "bg": "secondaryContainer", "minimum": 4.5 },
        { "name": "sidebar text", "fg": "onSurface", "bg": "surface", "minimum": 4.5 },
