{
  "comment": "Contrast and coverage contract for the remaining generated app themes. Pair names are scheme.json role names. Body and label text use the WCAG 4.5:1 threshold; borders, graph strokes and other UI marks use 3:1; decorative separators only need to be distinguishable from their surface.",
  "seeds": ["000000", "ffffff", "ff1a1a", "1a5cff", "00a86b", "ffd400", "8a2be2"],
  "variants": ["tonalspot", "vibrant", "content", "monochrome"],
  "apps": {
    "btop": {
      "template": "share/templates/btop.theme",
      "destination": "btop/themes/caelestia.theme",
      "templateName": "btop.theme",
      "required": [
        "theme[main_bg]", "theme[main_fg]", "theme[title]", "theme[hi_fg]",
        "theme[selected_bg]", "theme[selected_fg]", "theme[inactive_fg]",
        "theme[graph_text]", "theme[meter_bg]", "theme[proc_misc]",
        "theme[cpu_box]", "theme[mem_box]", "theme[net_box]", "theme[proc_box]",
        "theme[div_line]", "theme[temp_start]", "theme[temp_mid]", "theme[temp_end]",
        "theme[cpu_start]", "theme[cpu_mid]", "theme[cpu_end]",
        "theme[free_start]", "theme[free_mid]", "theme[free_end]",
        "theme[cached_start]", "theme[cached_mid]", "theme[cached_end]",
        "theme[available_start]", "theme[available_mid]", "theme[available_end]",
        "theme[used_start]", "theme[used_mid]", "theme[used_end]",
        "theme[download_start]", "theme[download_mid]", "theme[download_end]",
        "theme[upload_start]", "theme[upload_mid]", "theme[upload_end]",
        "theme[process_start]", "theme[process_mid]", "theme[process_end]"
      ],
      "pairs": [
        { "name": "main text", "fg": "onSurface", "bg": "surface", "minimum": 4.5 },
        { "name": "selected row", "fg": "onPrimaryContainer", "bg": "primaryContainer", "minimum": 4.5 },
        { "name": "inactive text", "fg": "outline", "bg": "surface", "minimum": 4.5 },
        { "name": "graph label", "fg": "tertiary", "bg": "surface", "minimum": 4.5 },
        { "name": "process detail label", "fg": "tertiary", "bg": "surface", "minimum": 4.5 },
        { "name": "meter background", "fg": "surfaceContainerHighest", "bg": "surface", "minimum": 1.1 },
        { "name": "divider", "fg": "outline", "bg": "surface", "minimum": 3.0 },
        { "name": "cpu border", "fg": "mauve", "bg": "surface", "minimum": 3.0 },
        { "name": "memory border", "fg": "green", "bg": "surface", "minimum": 3.0 },
        { "name": "network border", "fg": "maroon", "bg": "surface", "minimum": 3.0 },
        { "name": "process border", "fg": "blue", "bg": "surface", "minimum": 3.0 },
        { "name": "temperature start", "fg": "green", "bg": "surface", "minimum": 3.0 },
        { "name": "temperature middle", "fg": "yellow", "bg": "surface", "minimum": 3.0 },
        { "name": "temperature end", "fg": "red", "bg": "surface", "minimum": 3.0 },
        { "name": "cpu graph start", "fg": "teal", "bg": "surface", "minimum": 3.0 },
        { "name": "cpu graph middle", "fg": "sapphire", "bg": "surface", "minimum": 3.0 },
        { "name": "cpu graph end", "fg": "lavender", "bg": "surface", "minimum": 3.0 },
        { "name": "free meter start", "fg": "mauve", "bg": "surface", "minimum": 3.0 },
        { "name": "free meter middle", "fg": "lavender", "bg": "surface", "minimum": 3.0 },
        { "name": "free meter end", "fg": "blue", "bg": "surface", "minimum": 3.0 },
        { "name": "cached meter start", "fg": "sapphire", "bg": "surface", "minimum": 3.0 },
        { "name": "cached meter middle", "fg": "blue", "bg": "surface", "minimum": 3.0 },
        { "name": "cached meter end", "fg": "lavender", "bg": "surface", "minimum": 3.0 },
        { "name": "available meter start", "fg": "peach", "bg": "surface", "minimum": 3.0 },
        { "name": "available meter middle", "fg": "maroon", "bg": "surface", "minimum": 3.0 },
        { "name": "available meter end", "fg": "red", "bg": "surface", "minimum": 3.0 },
        { "name": "used meter start", "fg": "green", "bg": "surface", "minimum": 3.0 },
        { "name": "used meter middle", "fg": "teal", "bg": "surface", "minimum": 3.0 },
        { "name": "used meter end", "fg": "sky", "bg": "surface", "minimum": 3.0 },
        { "name": "download graph start", "fg": "peach", "bg": "surface", "minimum": 3.0 },
        { "name": "download graph middle", "fg": "maroon", "bg": "surface", "minimum": 3.0 },
        { "name": "download graph end", "fg": "red", "bg": "surface", "minimum": 3.0 },
        { "name": "upload graph start", "fg": "green", "bg": "surface", "minimum": 3.0 },
        { "name": "upload graph middle", "fg": "teal", "bg": "surface", "minimum": 3.0 },
        { "name": "upload graph end", "fg": "sky", "bg": "surface", "minimum": 3.0 },
        { "name": "process graph start", "fg": "sapphire", "bg": "surface", "minimum": 3.0 },
        { "name": "process graph middle", "fg": "lavender", "bg": "surface", "minimum": 3.0 },
        { "name": "process graph end", "fg": "mauve", "bg": "surface", "minimum": 3.0 }
      ]
    },
    "cava": {
      "template": "share/templates/cava.conf",
      "destination": "cava/config",
      "templateName": "cava.conf",
      "required": [
        "background = '{{ $surface }}'",
        "foreground = '{{ $onSurface }}'",
        "gradient = 1",
        "gradient_color_1 = '{{ $green }}'",
        "gradient_color_2 = '{{ $teal }}'",
        "gradient_color_3 = '{{ $sky }}'",
        "gradient_color_4 = '{{ $sapphire }}'",
        "gradient_color_5 = '{{ $blue }}'",
        "gradient_color_6 = '{{ $lavender }}'",
        "gradient_color_7 = '{{ $mauve }}'",
        "gradient_color_8 = '{{ $maroon }}'"
      ],
      "pairs": [
        { "name": "terminal text", "fg": "onSurface", "bg": "surface", "minimum": 4.5 },
        { "name": "gradient 1", "fg": "green", "bg": "surface", "minimum": 3.0 },
        { "name": "gradient 2", "fg": "teal", "bg": "surface", "minimum": 3.0 },
        { "name": "gradient 3", "fg": "sky", "bg": "surface", "minimum": 3.0 },
        { "name": "gradient 4", "fg": "sapphire", "bg": "surface", "minimum": 3.0 },
        { "name": "gradient 5", "fg": "blue", "bg": "surface", "minimum": 3.0 },
        { "name": "gradient 6", "fg": "lavender", "bg": "surface", "minimum": 3.0 },
        { "name": "gradient 7", "fg": "mauve", "bg": "surface", "minimum": 3.0 },
        { "name": "gradient 8", "fg": "maroon", "bg": "surface", "minimum": 3.0 }
      ]
    },
    "fuzzel": {
      "template": "share/templates/fuzzel.ini",
      "destination": "fuzzel/fuzzel.ini",
      "templateName": "fuzzel.ini",
      "uniqueSections": true,
      "required": [
        "[border]", "[colors]",
        "background={{ $surface }}ff",
        "text={{ $onSurface }}ff",
        "prompt={{ $primary }}ff",
        "placeholder={{ $outline }}ff",
        "input={{ $onSurface }}ff",
        "match={{ $tertiary }}ff",
        "selection={{ $primaryContainer }}ff",
        "selection-text={{ $onPrimaryContainer }}ff",
        "selection-match={{ $tertiary }}ff",
        "counter={{ $outline }}ff",
        "border={{ $outline }}ff"
      ],
      "pairs": [
        { "name": "entry text", "fg": "onSurface", "bg": "surface", "minimum": 4.5 },
        { "name": "prompt", "fg": "primary", "bg": "surface", "minimum": 4.5 },
        { "name": "placeholder", "fg": "outline", "bg": "surface", "minimum": 4.5 },
        { "name": "input text", "fg": "onSurface", "bg": "surface", "minimum": 4.5 },
        { "name": "match text", "fg": "tertiary", "bg": "surface", "minimum": 4.5 },
        { "name": "selected row", "fg": "onPrimaryContainer", "bg": "primaryContainer", "minimum": 4.5 },
        { "name": "selected match", "fg": "tertiary", "bg": "primaryContainer", "minimum": 4.5 },
        { "name": "counter", "fg": "outline", "bg": "surface", "minimum": 4.5 },
        { "name": "border", "fg": "outline", "bg": "surface", "minimum": 3.0 }
      ]
    },
    "micro": {
      "template": "share/templates/micro.micro",
      "destination": "micro/colorschemes/padilha.micro",
      "templateName": "micro.micro",
      "required": [
        "color-link default", "color-link comment", "color-link constant",
        "color-link constant.string", "color-link statement", "color-link type",
        "color-link selection", "color-link statusline", "color-link tabbar",
        "color-link error", "color-link match-brace", "color-link hlsearch",
        "color-link diff-added", "color-link diff-modified", "color-link diff-deleted"
      ],
      "pairs": [
        { "name": "default text", "fg": "onSurface", "bg": "surface", "minimum": 4.5 },
        { "name": "comment", "fg": "onSurfaceVariant", "bg": "surface", "minimum": 4.5 },
        { "name": "bright comment", "fg": "outline", "bg": "surface", "minimum": 4.5 },
        { "name": "constant", "fg": "maroon", "bg": "surface", "minimum": 4.5 },
        { "name": "string", "fg": "green", "bg": "surface", "minimum": 4.5 },
        { "name": "url", "fg": "blue", "bg": "surface", "minimum": 4.5 },
        { "name": "special character", "fg": "mauve", "bg": "surface", "minimum": 4.5 },
        { "name": "class name", "fg": "tertiary", "bg": "surface", "minimum": 4.5 },
        { "name": "macro", "fg": "red", "bg": "surface", "minimum": 4.5 },
        { "name": "statement", "fg": "primary", "bg": "surface", "minimum": 4.5 },
        { "name": "operator", "fg": "red", "bg": "surface", "minimum": 4.5 },
        { "name": "brackets", "fg": "outline", "bg": "surface", "minimum": 4.5 },
        { "name": "preprocessor", "fg": "red", "bg": "surface", "minimum": 4.5 },
        { "name": "type", "fg": "blue", "bg": "surface", "minimum": 4.5 },
        { "name": "special", "fg": "teal", "bg": "surface", "minimum": 4.5 },
        { "name": "todo", "fg": "tertiary", "bg": "surface", "minimum": 4.5 },
        { "name": "line number", "fg": "outline", "bg": "surface", "minimum": 4.5 },
        { "name": "current line number", "fg": "primary", "bg": "surface", "minimum": 4.5 },
        { "name": "gutter info", "fg": "blue", "bg": "surface", "minimum": 4.5 },
        { "name": "gutter error", "fg": "error", "bg": "surface", "minimum": 4.5 },
        { "name": "gutter warning", "fg": "tertiary", "bg": "surface", "minimum": 4.5 },
        { "name": "diff added", "fg": "green", "bg": "surface", "minimum": 4.5 },
        { "name": "diff modified", "fg": "tertiary", "bg": "surface", "minimum": 4.5 },
        { "name": "diff deleted", "fg": "red", "bg": "surface", "minimum": 4.5 },
        { "name": "error line", "fg": "onError", "bg": "error", "minimum": 4.5 },
        { "name": "selection", "fg": "onSurface", "bg": "primaryContainer", "minimum": 4.5 },
        { "name": "status line", "fg": "onSurface", "bg": "surfaceContainerHigh", "minimum": 4.5 },
        { "name": "inactive status line", "fg": "onSurfaceVariant", "bg": "surfaceContainer", "minimum": 4.5 },
        { "name": "status suggestions", "fg": "onSurface", "bg": "surfaceContainerHighest", "minimum": 4.5 },
        { "name": "tab bar", "fg": "onSurfaceVariant", "bg": "surfaceContainer", "minimum": 4.5 },
        { "name": "active tab", "fg": "onSurface", "bg": "surfaceContainerHigh", "minimum": 4.5 },
        { "name": "message", "fg": "onSurface", "bg": "surfaceContainerHigh", "minimum": 4.5 },
        { "name": "error message", "fg": "onError", "bg": "error", "minimum": 4.5 },
        { "name": "scrollbar", "fg": "outline", "bg": "surface", "minimum": 4.5 },
        { "name": "cursor line", "fg": "onSurface", "bg": "surfaceContainer", "minimum": 4.5 },
        { "name": "colour column", "fg": "onSurface", "bg": "surfaceContainerHighest", "minimum": 4.5 },
        { "name": "matching brace", "fg": "onPrimary", "bg": "primary", "minimum": 4.5 },
        { "name": "search highlight", "fg": "onPrimary", "bg": "primary", "minimum": 4.5 },
        { "name": "tab error", "fg": "onErrorContainer", "bg": "errorContainer", "minimum": 4.5 },
        { "name": "trailing whitespace", "fg": "onSurface", "bg": "errorContainer", "minimum": 4.5 },
        { "name": "divider", "fg": "outline", "bg": "surface", "minimum": 3.0 },
        { "name": "indent guide", "fg": "outlineVariant", "bg": "surface", "minimum": 1.5 }
      ]
    },
    "mc": {
      "template": "share/templates/mc-skin.ini",
      "destination": "mc/skins/caelestia.ini",
      "templateName": "mc-skin.ini",
      "support": {
        "lib/mcskin.lua": [
          "EditorLineState", "surfaceContainerHighest", "\"TempFg\", { \"outline\"",
          "\"DeviceFg\", { \"maroon\"", "\"ArchiveFg\", { \"sapphire\"", "\"DbFg\", { \"teal\""
        ]
      },
      "required": [
        "{{ $aliases }}", "[core]", "[dialog]", "[error]", "[filehighlight]",
        "[menu]", "[popupmenu]", "[buttonbar]", "[statusbar]", "[help]",
        "[editor]", "[viewer]", "[diffviewer]",
        "_default_ = MainFg;Main",
        "selected = SelectedFg;Selected",
        "markselect = MarkedFg;Selected;bold",
        "menuinactive = PaleFg;Dialog",
        "editlinestate = MainFg;EditorLineState"
      ],
      "pairs": [
        { "name": "main text", "fg": "onSurface", "bg": "surface", "minimum": 4.5 },
        { "name": "selected row", "fg": "onPrimaryContainer", "bg": "primaryContainer", "minimum": 4.5 },
        { "name": "marked and selected", "fg": "primary", "bg": "primaryContainer", "minimum": 4.5 },
        { "name": "panel header", "fg": "onSurfaceVariant", "bg": "surface", "minimum": 4.5 },
        { "name": "dialog text", "fg": "onSurface", "bg": "surfaceContainerHigh", "minimum": 4.5 },
        { "name": "dialog focus", "fg": "onPrimary", "bg": "primary", "minimum": 4.5 },
        { "name": "input text", "fg": "onSurface", "bg": "surfaceContainer", "minimum": 4.5 },
        { "name": "unchanged input", "fg": "outline", "bg": "surfaceContainer", "minimum": 4.5 },
        { "name": "disabled text", "fg": "outline", "bg": "surfaceContainerHigh", "minimum": 4.5 },
        { "name": "error text", "fg": "onError", "bg": "error", "minimum": 4.5 },
        { "name": "error focus", "fg": "onError", "bg": "errorDim", "minimum": 4.5 },
        { "name": "menu text", "fg": "onSurface", "bg": "surfaceContainer", "minimum": 4.5 },
        { "name": "menu selection", "fg": "onPrimary", "bg": "primary", "minimum": 4.5 },
        { "name": "inactive menu", "fg": "outline", "bg": "surfaceContainerHigh", "minimum": 4.5 },
        { "name": "top bar", "fg": "onSurfaceVariant", "bg": "surfaceContainerHigh", "minimum": 4.5 },
        { "name": "bottom bar", "fg": "onSurfaceVariant", "bg": "surfaceContainerHighest", "minimum": 4.5 },
        { "name": "bottom shortcut number", "fg": "onPrimary", "bg": "primary", "minimum": 4.5 },
        { "name": "help text", "fg": "onSurface", "bg": "surfaceContainer", "minimum": 4.5 },
        { "name": "help bold", "fg": "primary", "bg": "surfaceContainer", "minimum": 4.5 },
        { "name": "help italic", "fg": "tertiary", "bg": "surfaceContainer", "minimum": 4.5 },
        { "name": "help link", "fg": "blue", "bg": "surfaceContainer", "minimum": 4.5 },
        { "name": "editor line state", "fg": "onSurface", "bg": "surfaceContainerHighest", "minimum": 4.5 },
        { "name": "editor whitespace", "fg": "onSurface", "bg": "outlineVariant", "minimum": 4.5 },
        { "name": "editor frame", "fg": "outline", "bg": "surfaceContainerLowest", "minimum": 4.5 },
        { "name": "active editor frame", "fg": "primary", "bg": "surfaceContainerLowest", "minimum": 4.5 },
        { "name": "viewer bold", "fg": "primary", "bg": "surface", "minimum": 4.5 },
        { "name": "viewer underline", "fg": "blue", "bg": "surface", "minimum": 4.5 },
        { "name": "diff added", "fg": "onSuccess", "bg": "success", "minimum": 4.5 },
        { "name": "diff changed", "fg": "onTertiary", "bg": "tertiary", "minimum": 4.5 },
        { "name": "diff gap", "fg": "onError", "bg": "error", "minimum": 4.5 },
        { "name": "directory", "fg": "blue", "bg": "surface", "minimum": 4.5 },
        { "name": "executable", "fg": "success", "bg": "surface", "minimum": 4.5 },
        { "name": "symlink", "fg": "mauve", "bg": "surface", "minimum": 4.5 },
        { "name": "stale link", "fg": "red", "bg": "surface", "minimum": 4.5 },
        { "name": "device", "fg": "maroon", "bg": "surface", "minimum": 4.5 },
        { "name": "special file", "fg": "tertiary", "bg": "surface", "minimum": 4.5 },
        { "name": "core file", "fg": "maroon", "bg": "surface", "minimum": 4.5 },
        { "name": "temporary file", "fg": "outline", "bg": "surface", "minimum": 4.5 },
        { "name": "archive", "fg": "sapphire", "bg": "surface", "minimum": 4.5 },
        { "name": "document", "fg": "lavender", "bg": "surface", "minimum": 4.5 },
        { "name": "source file", "fg": "teal", "bg": "surface", "minimum": 4.5 },
        { "name": "media file", "fg": "sapphire", "bg": "surface", "minimum": 4.5 },
        { "name": "graph file", "fg": "tertiary", "bg": "surface", "minimum": 4.5 },
