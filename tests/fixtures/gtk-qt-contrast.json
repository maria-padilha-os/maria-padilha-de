  "focusPairs": [
    { "name": "GTK focus ring on window", "fg": "primary", "bg": "surface", "minimum": 3.0 },
    { "name": "GTK focus ring on raised surface", "fg": "primary", "bg": "surfaceContainer", "minimum": 3.0 },
    { "name": "GTK focus ring on highest surface", "fg": "primary", "bg": "surfaceContainerHighest", "minimum": 3.0 },
    { "name": "GTK focus ring inside selection", "fg": "onPrimaryContainer", "bg": "primaryContainer", "minimum": 3.0 },
    { "name": "GTK border on window", "fg": "outline", "bg": "surface", "minimum": 3.0 },
    { "name": "GTK border on view", "fg": "outline", "bg": "surfaceContainerLowest", "minimum": 3.0 },
    { "name": "GTK border on raised surface", "fg": "outline", "bg": "surfaceContainer", "minimum": 3.0 },
    { "name": "GTK border on highest surface", "fg": "outline", "bg": "surfaceContainerHighest", "minimum": 3.0 },
    { "name": "GTK menu border", "fg": "outline", "bg": "surfaceContainer", "minimum": 3.0 },
    { "name": "GTK tooltip border", "fg": "outline", "bg": "surfaceContainerHighest", "minimum": 3.0 },
    { "name": "Qt selection focus", "fg": "onPrimaryContainer", "bg": "primaryContainer", "minimum": 3.0 }
