{
  "comment": "WCAG 2.2 contrast contract for share/templates/gtk.css and the Qt colour templates. Pair names are scheme.json role names. Text pairs use the 4.5:1 body-text threshold; focus rings and borders are non-text UI indicators and use 3:1.",
  "seeds": ["000000", "ffffff", "ff1a1a", "1a5cff", "00a86b", "ffd400", "8a2be2"],
  "variants": ["tonalspot", "vibrant", "content", "monochrome"],
  "textPairs": [
    { "name": "GTK window text", "fg": "onSurface", "bg": "surface", "minimum": 4.5 },
    { "name": "GTK view and file chooser text", "fg": "onSurface", "bg": "surfaceContainerLowest", "minimum": 4.5 },
    { "name": "GTK headerbar text", "fg": "onSurface", "bg": "surfaceDim", "minimum": 4.5 },
    { "name": "GTK menu text", "fg": "onSurface", "bg": "surfaceContainer", "minimum": 4.5 },
    { "name": "GTK disabled menu text", "fg": "onSurfaceVariant", "bg": "surfaceContainer", "minimum": 4.5 },
    { "name": "GTK tooltip text", "fg": "onSurface", "bg": "surfaceContainerHighest", "minimum": 4.5 },
    { "name": "GTK button text", "fg": "onSurface", "bg": "surfaceContainerHigh", "minimum": 4.5 },
    { "name": "GTK selection text", "fg": "onPrimaryContainer", "bg": "primaryContainer", "minimum": 4.5 },
    { "name": "GTK accent button text", "fg": "onPrimary", "bg": "primary", "minimum": 4.5 },
    { "name": "GTK dialog text", "fg": "onSurface", "bg": "surface", "minimum": 4.5 },
    { "name": "GTK sidebar text", "fg": "onSurface", "bg": "surfaceContainerLow", "minimum": 4.5 },
    { "name": "GTK secondary sidebar text", "fg": "onSurface", "bg": "surfaceContainer", "minimum": 4.5 },
    { "name": "GTK card text", "fg": "onSurface", "bg": "surfaceContainer", "minimum": 4.5 },
    { "name": "GTK error text", "fg": "error", "bg": "surface", "minimum": 4.5 },
    { "name": "GTK warning text", "fg": "tertiary", "bg": "surface", "minimum": 4.5 },
    { "name": "GTK warning badge text", "fg": "onTertiaryContainer", "bg": "tertiaryContainer", "minimum": 4.5 },
    { "name": "GTK success text", "fg": "success", "bg": "surface", "minimum": 4.5 },
    { "name": "GTK success badge text", "fg": "onSuccess", "bg": "success", "minimum": 4.5 },
    { "name": "GTK link text", "fg": "primary", "bg": "surface", "minimum": 4.5 },
    { "name": "GTK placeholder text", "fg": "onSurfaceVariant", "bg": "surfaceContainerLowest", "minimum": 4.5 },
    { "name": "GTK inactive title text", "fg": "onSecondaryContainer", "bg": "secondaryContainer", "minimum": 4.5 },
    { "name": "Qt inactive text on window", "fg": "onSurfaceVariant", "bg": "surface", "minimum": 4.5 },
    { "name": "Qt inactive text on raised surface", "fg": "onSurfaceVariant", "bg": "surfaceContainerHigh", "minimum": 4.5 },
    { "name": "Qt disabled text on button", "fg": "onSurfaceVariant", "bg": "surfaceContainerHigh", "minimum": 4.5 },
    { "name": "Qt view text", "fg": "onSurface", "bg": "surfaceContainerLowest", "minimum": 4.5 },
    { "name": "Qt tooltip text", "fg": "onSurface", "bg": "surfaceContainerHighest", "minimum": 4.5 },
    { "name": "Qt selection text", "fg": "onPrimaryContainer", "bg": "primaryContainer", "minimum": 4.5 },
    { "name": "Qt active header text", "fg": "onSurface", "bg": "surfaceContainerHighest", "minimum": 4.5 }
