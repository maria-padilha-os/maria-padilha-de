[ColorEffects:Disabled]
# Keep disabled text on the generated onSurfaceVariant role. Blending it with
# a surface (the old ColorEffect=3/0.5 combination) dropped it below body-text
# contrast and produced a different result in each Qt style.
Color={{ $surfaceContainer }}
ColorAmount=0
ColorEffect=0
ContrastAmount=0
ContrastEffect=0
IntensityAmount=0
IntensityEffect=0

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={{ $surfaceContainer }}
ColorAmount=0
ColorEffect=0
ContrastAmount=0
ContrastEffect=0
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate={{ $surfaceContainer }}
BackgroundNormal={{ $surfaceContainerHigh }}
DecorationFocus={{ $primary }}
DecorationHover={{ $primary }}
ForegroundActive={{ $primary }}
ForegroundInactive={{ $onSurfaceVariant }}
ForegroundLink={{ $primary }}
ForegroundNegative={{ $error }}
ForegroundNeutral={{ $tertiary }}
ForegroundNormal={{ $onSurface }}
ForegroundPositive={{ $success }}
ForegroundVisited={{ $tertiary }}

[Colors:Complementary]
BackgroundAlternate={{ $surfaceContainerHigh }}
BackgroundNormal={{ $surfaceContainer }}
DecorationFocus={{ $primary }}
DecorationHover={{ $primary }}
ForegroundActive={{ $primary }}
ForegroundInactive={{ $onSurfaceVariant }}
ForegroundLink={{ $primary }}
ForegroundNegative={{ $error }}
ForegroundNeutral={{ $tertiary }}
ForegroundNormal={{ $onSurface }}
ForegroundPositive={{ $success }}
ForegroundVisited={{ $tertiary }}

[Colors:Header]
BackgroundAlternate={{ $surfaceContainer }}
BackgroundNormal={{ $surfaceDim }}
DecorationFocus={{ $primary }}
DecorationHover={{ $primary }}
ForegroundActive={{ $primary }}
ForegroundInactive={{ $onSurfaceVariant }}
ForegroundLink={{ $primary }}
ForegroundNegative={{ $error }}
ForegroundNeutral={{ $tertiary }}
ForegroundNormal={{ $onSurface }}
ForegroundPositive={{ $success }}
ForegroundVisited={{ $tertiary }}

[Colors:Header][Inactive]
BackgroundAlternate={{ $surfaceContainerHigh }}
BackgroundNormal={{ $surfaceContainer }}
DecorationFocus={{ $primary }}
DecorationHover={{ $primary }}
ForegroundActive={{ $primary }}
ForegroundInactive={{ $onSurfaceVariant }}
ForegroundLink={{ $primary }}
ForegroundNegative={{ $error }}
ForegroundNeutral={{ $tertiary }}
ForegroundNormal={{ $onSurfaceVariant }}
ForegroundPositive={{ $success }}
ForegroundVisited={{ $tertiary }}

[Colors:Selection]
# primaryContainer is the same selected fill used by GTK and Thunar. The focus
# decoration is the selection foreground so it cannot vanish into the fill.
BackgroundAlternate={{ $primaryContainer }}
BackgroundNormal={{ $primaryContainer }}
DecorationFocus={{ $onPrimaryContainer }}
DecorationHover={{ $onPrimaryContainer }}
ForegroundActive={{ $onPrimaryContainer }}
ForegroundInactive={{ $onPrimaryContainer }}
ForegroundLink={{ $onPrimaryContainer }}
ForegroundNegative={{ $onPrimaryContainer }}
ForegroundNeutral={{ $onPrimaryContainer }}
ForegroundNormal={{ $onPrimaryContainer }}
ForegroundPositive={{ $onPrimaryContainer }}
ForegroundVisited={{ $onPrimaryContainer }}

[Colors:Tooltip]
BackgroundAlternate={{ $surfaceContainerHigh }}
BackgroundNormal={{ $surfaceContainerHighest }}
DecorationFocus={{ $primary }}
DecorationHover={{ $primary }}
ForegroundActive={{ $primary }}
ForegroundInactive={{ $onSurfaceVariant }}
ForegroundLink={{ $primary }}
ForegroundNegative={{ $error }}
ForegroundNeutral={{ $tertiary }}
ForegroundNormal={{ $onSurface }}
ForegroundPositive={{ $success }}
ForegroundVisited={{ $tertiary }}

[Colors:View]
BackgroundAlternate={{ $surfaceContainerLow }}
BackgroundNormal={{ $surfaceContainerLowest }}
DecorationFocus={{ $primary }}
DecorationHover={{ $primary }}
ForegroundActive={{ $primary }}
ForegroundInactive={{ $onSurfaceVariant }}
ForegroundLink={{ $primary }}
ForegroundNegative={{ $error }}
ForegroundNeutral={{ $tertiary }}
ForegroundNormal={{ $onSurface }}
ForegroundPositive={{ $success }}
ForegroundVisited={{ $tertiary }}

[Colors:Window]
BackgroundAlternate={{ $surfaceContainerLow }}
BackgroundNormal={{ $surface }}
DecorationFocus={{ $primary }}
DecorationHover={{ $primary }}
ForegroundActive={{ $primary }}
ForegroundInactive={{ $onSurfaceVariant }}
ForegroundLink={{ $primary }}
ForegroundNegative={{ $error }}
ForegroundNeutral={{ $tertiary }}
ForegroundNormal={{ $onSurface }}
ForegroundPositive={{ $success }}
ForegroundVisited={{ $tertiary }}

[General]
ColorScheme=Caelestia
Name=Caelestia {{ $mode }}
shadeSortColumn=true

[KDE]
contrast=4

[WM]
activeBackground={{ $surfaceContainerHighest }}
activeBlend={{ $surfaceContainerHighest | rgb }}
activeForeground={{ $onSurface }}
inactiveBackground={{ $secondaryContainer }}
inactiveBlend={{ $secondaryContainer | rgb }}
inactiveForeground={{ $onSecondaryContainer }}
