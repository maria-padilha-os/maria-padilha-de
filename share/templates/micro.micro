# Maria Padilha micro colourscheme ({{ $mode }}).
# Generated by padilha-theme from the Material You palette; do not edit.
# Template: maria-padilha-de/share/templates/micro.micro

color-link default "{{ $onSurface }},{{ $surface }}"

# Syntax: the same ayu-shaped grammar as nvim's colours/caelestia.lua, but
# every hue is drawn from the current scheme instead of a fixed table.
color-link comment "{{ $onSurfaceVariant }}"
color-link comment.bright "{{ $outline }}"
color-link constant "{{ $peach }}"
color-link constant.bool "{{ $peach }}"
color-link constant.number "{{ $peach }}"
color-link constant.string "{{ $green }}"
color-link constant.string.url "underline {{ $sky }}"
color-link constant.specialChar "{{ $mauve }}"
color-link identifier "{{ $onSurface }}"
color-link identifier.class "{{ $yellow }}"
color-link identifier.macro "{{ $pink }}"
color-link identifier.var "{{ $onSurface }}"
color-link statement "{{ $primary }}"
color-link symbol "{{ $onSurface }}"
color-link symbol.operator "{{ $red }}"
color-link symbol.brackets "{{ $outline }}"
color-link preproc "{{ $pink }}"
color-link type "{{ $blue }}"
color-link special "{{ $teal }}"
color-link underlined "underline {{ $onSurface }}"

# Chrome: surfaces, tabs and the status line.
color-link error "bold {{ $onError }},{{ $error }}"
color-link todo "bold {{ $yellow }}"
color-link selection "{{ $onSurface }},{{ $primaryContainer }}"
color-link statusline "{{ $onSurface }},{{ $surfaceContainerHigh }}"
color-link statusline.inactive "{{ $onSurfaceVariant }},{{ $surfaceContainer }}"
color-link statusline.suggestions "{{ $onSurface }},{{ $surfaceContainerHighest }}"
color-link tabbar "{{ $onSurfaceVariant }},{{ $surfaceContainer }}"
color-link tabbar.active "bold {{ $onSurface }},{{ $surfaceContainerHigh }}"
color-link message "{{ $onSurface }},{{ $surfaceContainerHigh }}"
color-link error-message "bold {{ $onError }},{{ $error }}"
color-link divider "{{ $outlineVariant }},{{ $surface }}"
color-link scrollbar "{{ $outline }},{{ $surface }}"

# Gutter, cursor and search.
color-link indent-char "{{ $outlineVariant }}"
color-link line-number "{{ $outline }}"
color-link current-line-number "bold {{ $primary }}"
color-link gutter-info "{{ $blue }}"
color-link gutter-error "{{ $error }}"
color-link gutter-warning "{{ $yellow }}"
color-link cursor-line ",{{ $surfaceContainer }}"
color-link color-column ",{{ $surfaceContainerHighest }}"
color-link match-brace "bold {{ $onPrimary }},{{ $primary }}"
color-link hlsearch "{{ $onPrimary }},{{ $primary }}"

# Diffs and whitespace warnings.
color-link diff-added "{{ $green }}"
color-link diff-modified "{{ $yellow }}"
color-link diff-deleted "{{ $red }}"
color-link tab-error "{{ $onErrorContainer }},{{ $errorContainer }}"
color-link trailingws ",{{ $errorContainer }}"
color-link ignore "default"
