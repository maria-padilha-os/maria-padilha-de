[Desktop Entry]
Type=Application
Name=Mail
Name[pt_BR]=Correio
GenericName=Email
GenericName[pt_BR]=E-mail
Comment=Open mailto: links in Thunderbird (optional)
Comment[pt_BR]=Abrir links mailto: no Thunderbird (opcional)
Exec=padilha-mail %u
Icon=thunderbird
Terminal=false
Categories=Network;Email;
Keywords=email;mail;inbox;thunderbird;
Keywords[pt_BR]=email;correio;caixa de entrada;thunderbird;
MimeType=x-scheme-handler/mailto;
StartupNotify=true
