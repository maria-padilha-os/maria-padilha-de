# Maintainer: Maria Padilha <maria-padilha@localhost>
#
# Maria Padilha is developed in place, with the packaging directory inside the
# checkout. The source here is the release tarball exported by tools/release.sh,
# which is why there is a local source and no URL yet.
pkgname=maria-padilha
pkgver=0.1.1
pkgrel=3
pkgdesc="Desktop Maria Padilha: a Wayland desktop on Hyprland and Quickshell"
arch=('x86_64')
url="https://github.com/maria-padilha-os/maria-padilha-de"
license=('GPL-3.0-only')
# The desktop shipped as `lilith` before this rename; this package replaces it.
conflicts=('lilith')
provides=('lilith')
makedepends=('cmake' 'ninja')
depends=(
    'quickshell'
    'qt6-base'
    'qt6-declarative'
    'libpipewire'
    'aubio'
    'libcava'
    'libqalculate'
    'lm_sensors'
    'hyprland'
    'brightnessctl'
    'python'
    'lua'
    'imagemagick'
    'micro'
    'xdg-utils'
    'jq'
    # Started by hypr/hyprland/execs.lua. The shell still runs without them,
    # but a "complete desktop" install loses keyring, polkit, idle, night
    # light, trash cleanup, clipboard history and the pickers.
    'hypridle'
    'hyprsunset'
    'trash-cli'
    'gnome-keyring'
    'polkit-gnome'
    'bluez-utils'
    'wl-clipboard'
    'cliphist'
    'fuzzel'
    'hyprlock'
)
optdepends=(
    'sass: Discord theme compilation'
    'neovim: alternative editor (install.sh --editor nvim)'
    'clang: C/C++/Objective-C language server for micro (clangd)'
    'lua-language-server: Lua language server for micro'
    'pyright: Python language server for micro'
    'typescript-language-server: JavaScript/TypeScript language server for micro'
    'gopls: Go language server for micro'
    'rust-analyzer: Rust language server for micro'
    'bash-language-server: shell language server for micro'
    'yaml-language-server: YAML language server for micro'
    'marksman: Markdown language server for micro'
    'zls: Zig language server for micro'
    'grim: screenshots'
    'slurp: region selection'
    'swappy: annotate screenshots'
    'gpu-screen-recorder: screen recording'
    'btop: system monitor themes'
    'papirus-icon-theme: icon theme the GTK templates name'
    'ttf-jetbrains-mono-nerd: terminal and bar font'
)
options=('!strip')  # the shell is a QML tree; stripping breaks nothing but helps nothing

# Built from the release tarball, not from the checkout: tools/release.sh
# exports HEAD into packaging/maria-padilha-$pkgver.tar.gz. The source is
# generated next to the recipe, so a checksum of it would only check our own
# output.
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

_srcdir() { printf '%s/%s-%s' "$srcdir" "$pkgname" "$pkgver"; }

build() {
    cd "$(_srcdir)"
    cmake -S shell -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DINSTALL_QSCONFDIR=/etc/xdg/quickshell/caelestia \
        -DVERSION="$pkgver" \
        -DGIT_REVISION="$(git -C "$startdir/.." rev-parse --short HEAD 2>/dev/null || echo unknown)"
    cmake --build build -j"$(nproc)"
}

package() {
    cd "$(_srcdir)"

    # The shell: QML modules into /usr/lib/qt6/qml and the tree into
    # /etc/xdg/quickshell/caelestia, which is where `qs -c caelestia` looks.
    DESTDIR="$pkgdir" cmake --install build --prefix /usr

    # The commands keep their relative layout (bin/lib/share) because they
    # resolve their data next to themselves; /usr/bin only carries links.
    install -d "$pkgdir/usr/lib/maria-padilha"
    cp -R --preserve=mode,timestamps bin lib share "$pkgdir/usr/lib/maria-padilha/"
    chmod 755 "$pkgdir/usr/lib/maria-padilha/bin/"*
    install -Dm 644 KEYBINDS.md "$pkgdir/usr/lib/maria-padilha/share/KEYBINDS.md"
    if [ -d extensions ]; then
        cp -R extensions "$pkgdir/usr/lib/maria-padilha/share/"
    fi
    # `padilha doctor` compares the running Hyprland with the pin.
    install -Dm 644 upstream.json "$pkgdir/usr/lib/maria-padilha/upstream.json"

    install -d "$pkgdir/usr/bin"
    commands=(padilha padilha-brightness padilha-config padilha-session padilha-lock padilha-shell-watch \
        padilha-theme padilha-daylight padilha-reload padilha-shot padilha-record padilha-clipboard padilha-emoji)
    for cmd in "${commands[@]}"; do
        ln -s "/usr/lib/maria-padilha/bin/$cmd" "$pkgdir/usr/bin/$cmd"
        # Compatibility: the old command names point at the same files.
        ln -s "/usr/lib/maria-padilha/bin/$cmd" "$pkgdir/usr/bin/lilith${cmd#padilha}"
    done

    # A session entry: the desktop's own entry point, so the greeter lists
    # Maria Padilha.
    install -Dm 644 session/maria-padilha.desktop "$pkgdir/usr/share/wayland-sessions/maria-padilha.desktop"

    # Optional systemd user units; they are inert until the user enables them.
    # They call the installed commands in /usr/bin, so they install verbatim.
    install -d "$pkgdir/usr/lib/systemd/user"
    for unit in session/systemd/user/*.service session/systemd/user/*.target; do
        install -Dm 644 "$unit" "$pkgdir/usr/lib/systemd/user/$(basename "$unit")"
    done

    install -Dm 644 shell/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm 644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm 644 ARCHITECTURE.md CONFIG.md UPSTREAM.md "$pkgdir/usr/share/doc/$pkgname/"
}
