[Unit]
Description=Padilha desktop shell
Documentation=file:/home/machine/.config/padilha/session/README.md
After=padilha-session.target
PartOf=padilha-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
WorkingDirectory=%h
Environment=HOME=%h
Environment=XDG_CONFIG_HOME=%h/.config
Environment=XDG_STATE_HOME=%h/.local/state
Environment=XDG_RUNTIME_DIR=%t
Environment=XDG_CURRENT_DESKTOP=Hyprland
Environment=XDG_SESSION_TYPE=wayland
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# WAYLAND_DISPLAY, DISPLAY and HYPRLAND_INSTANCE_SIGNATURE are inherited from
# the user manager; Hyprland imports them at startup. Do not hard-code the
# socket name.
ExecStartPre=-/home/machine/.config/padilha/bin/padilha-config compile --quiet
ExecStartPre=-/home/machine/.config/padilha/bin/padilha-daylight --once
ExecStart=/usr/bin/qs -c caelestia -n
ExecStop=-/usr/bin/caelestia shell -k
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
KillMode=mixed
