[Unit]
Description=Padilha desktop shell
PartOf=padilha-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
# Colours and config before the first frame.
ExecStartPre=-/usr/bin/padilha-config compile --quiet
ExecStartPre=-/usr/bin/padilha-daylight --once
ExecStart=/usr/bin/qs -c caelestia -n
# Quickshell's own IPC shutdown, not the Python CLI.
ExecStop=-/usr/bin/qs -c caelestia kill
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
KillMode=mixed
