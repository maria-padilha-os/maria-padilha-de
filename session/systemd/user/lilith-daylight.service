[Unit]
Description=Lilith daylight wallpaper and palette switcher
After=lilith-session.target lilith-shell.service
Wants=lilith-shell.service
PartOf=lilith-session.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h
Environment=HOME=%h
Environment=XDG_CONFIG_HOME=%h/.config
Environment=XDG_STATE_HOME=%h/.local/state
Environment=XDG_RUNTIME_DIR=%t
Environment=XDG_CURRENT_DESKTOP=Hyprland
Environment=XDG_SESSION_TYPE=wayland
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/lilith-daylight
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
